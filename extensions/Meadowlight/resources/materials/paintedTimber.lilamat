{
 "format": "lilamat",
 "version": 1,
 "name": "PaintedTimber",
 "meta": {
  "name": "Painted Timber",
  "category": "Meadowlight/Wood",
  "tags": [
   "meadowlight",
   "stylised",
   "hand-painted",
   "painterly",
   "wood",
