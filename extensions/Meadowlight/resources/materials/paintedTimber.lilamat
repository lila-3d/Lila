    ]
   },
   {
    "name": "wear",
    "kind": "param",
    "type": "float",
    "default": 0.2,
    "label": "Wear",
    "description": "Splits along the grain.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
     "Material.wear"
    ]
   },
   {
    "name": "age",
    "kind": "param",
