    ]
   },
   {
    "name": "wear",
    "kind": "param",
    "type": "float",
    "default": 0.15,
    "label": "Wear",
    "description": "Fewer flowers.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
     "Material.wear"
    ]
   },
   {
    "name": "age",
    "kind": "param",
    "type": "float",
