  "subgroups": {
   "WarmStucco": {
    "name": "WarmStucco",
    "typeVersion": 1,
    "description": "Sun-warmed painted stucco: peach and cream wash, soft blotches, a few bricks peeking through where it has fallen away.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Wash.seed",
       "Patches.seed",
       "UnderBrick.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.4,
      "label": "Wear",
      "description": "Fallen-away patches showing brick.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Patches2.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.3,
      "label": "Age",
      "description": "Rain streaks and dirt at the base.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Paint.z",
       "BrickPaint.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Wash",
      "type": "clouds",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 3,
       "octaves": 5
      }
     },
     {
      "name": "Patches",
      "type": "perlin",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 4,
       "octaves": 5,
       "persistence": 0.6
      }
     },
     {
      "name": "UnderBrick",
      "type": "bricks",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "rows": 16,
       "columns": 5,
       "mortar": 0.12,
       "bevel": 0.15
      }
     },
     {
      "name": "Patches2",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float pa = smoothstep(0.78 - p.x * 0.3, 0.8 - p.x * 0.3, texToFloat(a.sample(uv)));\nfloat br = texToFloat(b.sample(uv));\nreturn float4(pa, br, c.sample(uv), 1.0);",
       "x": 0.4
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float v = 0.6 + (a.sample(uv).z - 0.5) * 0.06 - a.sample(uv).x * (0.35 - a.sample(uv).y * 0.12);\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "ValueLight",
      "type": "emboss",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "angle": 135.0,
       "intensity": 1.0
      }
     },
     {
      "name": "ValueOcclusion",
      "type": "blur",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.02
      }
     },
     {
      "name": "Value",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float h = texToFloat(c.sample(uv));\nfloat l = texToFloat(a.sample(uv));\nfloat cav = saturate((texToFloat(b.sample(uv)) - h) * 8.0);\nfloat v = 0.5 + (l - 0.5) * 1.0000 + (h - 0.5) * 0.5 - cav * 0.6000 + 0.1000;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "WashValue",
      "type": "pixelProcessor",
      "position": [
       1200.0,
       0.0
      ],
      "values": {
       "expression": "float v = texToFloat(a.sample(uv)) + (b.sample(uv).z - 0.5) * 0.9;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Strokes",
      "type": "image",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "file": "strokes/strokes_dabs.png",
       "tiles": 4
      }
     },
     {
      "name": "Paint",
      "type": "pixelProcessor",
      "position": [
       1440.0,
       0.0
      ],
      "values": {
       "expression": "float t = texToFloat(a.sample(uv));\nfloat4 s = b.sample(uv);\nt = saturate(t + (s.a - 0.5) * 0.4500 * (0.4 + p.z) + (s.b - 0.5) * 0.25);\nfloat k = t * 4.0000;\nt = (floor(k) + smoothstep(0.3, 0.7, frac(k))) / 4.0000;\nfloat3 c = t < 0.34 ? lerp(float3(0.6039, 0.4314, 0.4157), float3(0.8471, 0.6118, 0.4863), t / 0.34) : (t < 0.67 ? lerp(float3(0.8471, 0.6118, 0.4863), float3(0.9333, 0.7490, 0.5804), (t - 0.34) / 0.33) : lerp(float3(0.9333, 0.7490, 0.5804), float3(0.9804, 0.8941, 0.7529), (t - 0.67) / 0.33));\nreturn float4(c, 1.0);",
       "z": 0.5
      }
     },
     {
      "name": "BrickPaint",
      "type": "pixelProcessor",
      "position": [
       1440.0,
       160.0
      ],
      "values": {
       "expression": "float t = texToFloat(a.sample(uv));\nfloat4 s = b.sample(uv);\nt = saturate(t + (s.a - 0.5) * 0.3000 * (0.4 + p.z) + (s.b - 0.5) * 0.25);\nfloat k = t * 5.0000;\nt = (floor(k) + smoothstep(0.3, 0.7, frac(k))) / 5.0000;\nfloat3 c = t < 0.34 ? lerp(float3(0.3529, 0.2039, 0.2196), float3(0.6039, 0.3294, 0.2667), t / 0.34) : (t < 0.67 ? lerp(float3(0.6039, 0.3294, 0.2667), float3(0.7686, 0.4784, 0.3451), (t - 0.34) / 0.33) : lerp(float3(0.7686, 0.4784, 0.3451), float3(0.8784, 0.6275, 0.4784), (t - 0.67) / 0.33));\nreturn float4(c, 1.0);",
       "z": 0.5
      }
     },
     {
      "name": "PatchMask",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = a.sample(uv).x;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       1680.0,
       0.0
      ],
      "values": {
       "expression": "float k = texToFloat(c.sample(uv));\nfloat3 c0 = lerp(a.sample(uv).rgb, b.sample(uv).rgb, k);\nfloat streak = smoothstep(0.6, 0.9, frac(uv.x * 7.0 + sin(uv.x * 40.0) * 0.05)) * smoothstep(0.4, 0.0, uv.y);\nc0 = lerp(c0, c0 * float3(0.7216, 0.6588, 0.6275), saturate(streak + smoothstep(0.25, 0.0, uv.y) * 0.6) * p.y * 0.6);\nreturn float4(c0, 1.0);",
       "y": 0.3
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.9000 + (texToFloat(a.sample(uv)) - 0.5) * 0.05;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "intensity": 0.5
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       640.0
      ],
      "values": {
       "radius": 0.03,
       "depth": 0.1,
       "strength": 0.5
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       1920.0,
       0.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       2160.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       960.0,
       160.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       2640.0,
       0.0
      ],
      "values": {}
     }
    ],
