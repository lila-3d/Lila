    0.1441
   ],
   "paletteContrast": 0.4,
   "specularTint": 0.6
  }
 },
 "graph": {
  "name": "MeadowGrass",
  "typeVersion": 1,
  "description": "Soft painted meadow grass: tufts in cool teal shadow to sunny yellow-green, stroked in short soft dabs.",
  "inputs": [
   {
    "name": "seed",
    "kind": "param",
    "type": "seed",
    "default": 0,
    "label": "Seed",
    "description": "Changes the pattern without changing the look.",
