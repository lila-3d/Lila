  ],
  "author": "Lila",
  "licence": "CC0-1.0",
  "version": "1.0",
  "description": "Soft painted meadow grass: tufts in cool teal shadow to sunny yellow-green, stroked in short soft dabs.",
  "shadingModel": "painterly",
  "shading": {
   "shadingModel": "painterly",
   "strokeMap": "strokes_soft",
   "strokeScale": 20.0,
   "strokeNormal": 0.45,
   "paletteShadow": [
    0.0284,
    0.1022,
    0.1022
   ],
