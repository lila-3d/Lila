    ]
   },
   {
    "name": "wear",
    "kind": "param",
    "type": "float",
    "default": 0.15,
    "label": "Wear",
    "description": "Trodden, flattened patches.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
     "Material.wear"
    ]
   },
   {
    "name": "age",
    "kind": "param",
    "type": "float",
    "default": 0.2,
    "label": "Age",
    "description": "Late-summer gold in the tips.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
     "Material.age"
    ]
   },
   {
    "name": "colorVariation",
    "kind": "param",
    "type": "float",
    "default": 0.5,
    "label": "Colour Variation",
    "description": "How much the colour wanders across the surface.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
     "Material.colorVariation"
    ]
   },
   {
    "name": "hue",
    "kind": "param",
    "type": "float",
    "default": 0.0,
    "label": "Hue",
    "description": "Shifts the base colour's hue, in turns.",
    "min": -0.5,
    "max": 0.5,
    "targets": [
     "Material.hue"
    ]
   }
  ],
  "nodes": [
   {
    "name": "Material",
    "type": "Group",
    "position": [
     0.0,
