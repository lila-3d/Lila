  "subgroups": {
   "MeadowGrass": {
    "name": "MeadowGrass",
    "typeVersion": 1,
    "description": "Soft painted meadow grass: tufts in cool teal shadow to sunny yellow-green, stroked in short soft dabs.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Tufts.seed",
       "Rolling.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.15,
      "label": "Wear",
      "description": "Trodden, flattened patches.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Height.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.2,
      "label": "Age",
      "description": "Late-summer gold in the tips.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Gold.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Paint.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Tuft",
      "type": "pixelProcessor",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "expression": "float2 q = uv - 0.5;\nfloat r = length(q * float2(1.0, 1.4));\nfloat v = sqrt(saturate(1.0 - r / 0.45)) * (0.6 + 0.4 * saturate(0.5 - q.y));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Tufts",
      "type": "splatter",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "countX": 10,
       "countY": 10,
       "perCell": 6,
       "size": 0.8,
       "sizeRandom": 0.5,
       "rotationRandom": 0.15,
       "valueRandom": 0.3,
       "blend": "max"
      }
     },
     {
      "name": "Rolling",
      "type": "clouds",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 3,
       "octaves": 4
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float v = 0.25 + c.sample(uv) * 0.5 + (texToFloat(d.sample(uv)) - 0.5) * 0.15 - p.x * 0.15 * c.sample(uv);\nreturn float4(v, v, v, 1.0);",
       "x": 0.15
      }
     },
     {
      "name": "ValueLight",
      "type": "emboss",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "angle": 135.0,
       "intensity": 1.0
      }
     },
     {
      "name": "ValueOcclusion",
      "type": "blur",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.02
      }
     },
     {
      "name": "Value",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float h = texToFloat(c.sample(uv));\nfloat l = texToFloat(a.sample(uv));\nfloat cav = saturate((texToFloat(b.sample(uv)) - h) * 8.0);\nfloat v = 0.5 + (l - 0.5) * 1.2000 + (h - 0.5) * 0.5 - cav * 0.8000 + 0.0000;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Strokes",
      "type": "image",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "file": "strokes/strokes_soft.png",
       "tiles": 6
      }
     },
     {
      "name": "Paint",
      "type": "pixelProcessor",
      "position": [
       1200.0,
       0.0
      ],
      "values": {
       "expression": "float t = texToFloat(a.sample(uv));\nfloat4 s = b.sample(uv);\nt = saturate(t + (s.a - 0.5) * 0.3000 * (0.4 + p.z) + (s.b - 0.5) * 0.25);\nfloat k = t * 5.0000;\nt = (floor(k) + smoothstep(0.3, 0.7, frac(k))) / 5.0000;\nfloat3 c = t < 0.34 ? lerp(float3(0.1647, 0.2980, 0.2902), float3(0.2471, 0.4784, 0.2902), t / 0.34) : (t < 0.67 ? lerp(float3(0.2471, 0.4784, 0.2902), float3(0.4745, 0.6588, 0.2902), (t - 0.34) / 0.33) : lerp(float3(0.4745, 0.6588, 0.2902), float3(0.8118, 0.8392, 0.4784), (t - 0.67) / 0.33));\nreturn float4(c, 1.0);",
       "z": 0.5
      }
     },
     {
      "name": "Gold",
      "type": "pixelProcessor",
      "position": [
       1440.0,
       0.0
      ],
      "values": {
       "expression": "float3 c0 = a.sample(uv).rgb;\nfloat tip = smoothstep(0.55, 0.9, texToFloat(c.sample(uv)));\nc0 = lerp(c0, c0 * float3(0.9412, 0.8157, 0.5020) * 1.25, tip * p.y);\nreturn float4(c0, 1.0);",
       "y": 0.2
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.8500 + (texToFloat(a.sample(uv)) - 0.5) * 0.05;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "intensity": 0.6
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       640.0
      ],
      "values": {
       "radius": 0.03,
       "depth": 0.1,
       "strength": 0.5
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       1680.0,
       0.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       1920.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       960.0,
       160.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       2400.0,
       0.0
      ],
      "values": {}
     }
    ],
    "links": [
