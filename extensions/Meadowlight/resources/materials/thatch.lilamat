 "graph": {
  "name": "Thatch",
  "typeVersion": 1,
  "description": "Painted straw thatch: combed bundles in golden courses, deep amber shadow between them.",
  "inputs": [
   {
    "name": "seed",
    "kind": "param",
    "type": "seed",
    "default": 0,
    "label": "Seed",
    "description": "Changes the pattern without changing the look.",
    "targets": [
