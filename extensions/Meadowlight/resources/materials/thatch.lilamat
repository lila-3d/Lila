  "subgroups": {
   "Thatch": {
    "name": "Thatch",
    "typeVersion": 1,
    "description": "Painted straw thatch: combed bundles in golden courses, deep amber shadow between them.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Straw.seed",
       "Bundles.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.2,
      "label": "Wear",
      "description": "Softens the relief, as if worn down.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "WornRelief.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.4,
      "label": "Age",
      "description": "Weathering to grey-brown.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Weathering.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Paint.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Straw",
      "type": "directional",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "angle": 90.0,
       "scaleAlong": 2,
       "scaleAcross": 80,
       "octaves": 4,
       "persistence": 0.6
      }
     },
     {
      "name": "Bundles",
      "type": "directional",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "angle": 90.0,
       "scaleAlong": 1,
       "scaleAcross": 10,
       "octaves": 2
      }
     },
     {
      "name": "Courses",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float course = frac(uv.y * 5.0 + texToFloat(b.sample(uv)) * 0.15);\nfloat lip = smoothstep(0.0, 0.85, course);\nfloat s = texToFloat(a.sample(uv));\nfloat hgt = lip * (0.7 + s * 0.3) + (texToFloat(b.sample(uv)) - 0.5) * 0.15;\nreturn float4(hgt, s, course, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float v = 0.1 + a.sample(uv).x * 0.7;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "ValueLight",
      "type": "emboss",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "angle": 135.0,
       "intensity": 1.0
      }
     },
     {
      "name": "ValueOcclusion",
      "type": "blur",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.02
      }
     },
     {
      "name": "Value",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float h = texToFloat(c.sample(uv));\nfloat l = texToFloat(a.sample(uv));\nfloat cav = saturate((texToFloat(b.sample(uv)) - h) * 8.0);\nfloat v = 0.5 + (l - 0.5) * 1.0000 + (h - 0.5) * 0.5 - cav * 1.0000 + 0.0500;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Strokes",
      "type": "image",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "file": "strokes/strokes_bristle.png",
       "tiles": 6
      }
     },
     {
      "name": "Paint",
      "type": "pixelProcessor",
      "position": [
       1200.0,
       0.0
      ],
      "values": {
       "expression": "float t = texToFloat(a.sample(uv));\nfloat4 s = b.sample(uv);\nt = saturate(t + (s.a - 0.5) * 0.3000 * (0.4 + p.z) + (s.b - 0.5) * 0.25);\nfloat k = t * 5.0000;\nt = (floor(k) + smoothstep(0.3, 0.7, frac(k))) / 5.0000;\nfloat3 c = t < 0.34 ? lerp(float3(0.2902, 0.1804, 0.1882), float3(0.6039, 0.4157, 0.2039), t / 0.34) : (t < 0.67 ? lerp(float3(0.6039, 0.4157, 0.2039), float3(0.8471, 0.6588, 0.2902), (t - 0.34) / 0.33) : lerp(float3(0.8471, 0.6588, 0.2902), float3(0.9647, 0.8784, 0.5412), (t - 0.67) / 0.33));\nreturn float4(c, 1.0);",
       "z": 0.5
      }
     },
     {
      "name": "Weathering",
      "type": "pixelProcessor",
      "position": [
       1440.0,
       0.0
      ],
      "values": {
       "expression": "float3 c0 = a.sample(uv).rgb;\nc0 = lerp(c0, dot(c0, float3(0.3, 0.5, 0.2)).xxx * float3(1.0, 0.95, 0.88), p.y * 0.45);\nreturn float4(c0, 1.0);",
       "y": 0.4
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.9000 + (texToFloat(a.sample(uv)) - 0.5) * 0.05;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "WornRelief",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = 0.5 + (texToFloat(a.sample(uv)) - 0.5) * (1.0 - p.x * 0.6);\nreturn float4(v, v, v, 1.0);",
       "x": 0.2
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       960.0,
       160.0
      ],
      "values": {
       "intensity": 0.8
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       960.0,
       320.0
      ],
      "values": {
       "radius": 0.03,
       "depth": 0.1,
       "strength": 0.5
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       1680.0,
       0.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       1920.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       960.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       2400.0,
       0.0
      ],
      "values": {}
     }
    ],
    "links": [
     [
