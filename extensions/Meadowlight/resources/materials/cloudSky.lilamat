      "type": "color"
     }
    ],
    "nodes": [
     {
      "name": "Cumulus",
      "type": "clouds",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 2,
       "octaves": 6,
       "persistence": 0.5,
       "mode": "billow"
      }
     },
     {
      "name": "Wisps",
      "type": "clouds",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 6,
       "octaves": 5,
       "persistence": 0.55
      }
     },
     {
      "name": "Clouds",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float v = uv.y;\nfloat band = smoothstep(0.15, 0.45, v) * (1.0 - smoothstep(0.75, 0.95, v));\nfloat c0 = texToFloat(a.sample(uv)) * 0.8 + texToFloat(b.sample(uv)) * 0.3;\nfloat cov = smoothstep(0.52 - p.x * 0.3, 0.66 - p.x * 0.3, c0 * (0.6 + band * 0.55));\nfloat lit = saturate(0.5 + (texToFloat(a.sample(uv + float2(-0.01, 0.015))) - texToFloat(a.sample(uv))) * -6.0 + (v - 0.4) * 0.6);\nreturn float4(cov, lit, v, 1.0);",
       "x": 0.4
      }
     },
     {
      "name": "Strokes",
      "type": "image",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "file": "strokes/strokes_soft.png",
       "tiles": 3
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat4 k = b.sample(uv);\nfloat3 skyc = lerp(float3(0.8118, 0.8863, 0.9098), float3(0.3098, 0.5255, 0.7529), smoothstep(0.1, 0.95, s.z + (k.a - 0.5) * 0.06));\nskyc = lerp(skyc, float3(0.9647, 0.8471, 0.6902), (1.0 - smoothstep(0.0, 0.35, s.z)) * p.y);\nfloat t = saturate(s.y + (k.a - 0.5) * 0.3 * (0.4 + p.z) + (k.b - 0.5) * 0.2);\nt = (floor(t * 4.0) + smoothstep(0.3, 0.7, frac(t * 4.0))) / 4.0;\nfloat3 cloud = t < 0.5 ? lerp(float3(0.6039, 0.5804, 0.7216), float3(0.8784, 0.8314, 0.8627), t / 0.5) : lerp(float3(0.8784, 0.8314, 0.8627), float3(1.0000, 0.9647, 0.8863), (t - 0.5) / 0.5);\ncloud = lerp(cloud, cloud * float3(1.0000, 0.8471, 0.7216), p.y * 0.5);\nfloat3 c0 = lerp(skyc, cloud, s.x);\nreturn float4(c0, 1.0);",
       "z": 0.5,
       "y": 0.2
      }
     },
     {
      "name": "Emissive",
      "type": "pixelProcessor",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "expression": "return float4(a.sample(uv).rgb * 0.6, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.5 + a.sample(uv).x * 0.02;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "expression": "float v = 0.95;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "intensity": 0.1
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "radius": 0.01,
       "depth": 0.01,
       "strength": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       240.0,
       160.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "EmissiveLinear",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1440.0,
       0.0
      ],
      "values": {}
     }
    ],
    "links": [
     [
