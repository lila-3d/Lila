  ],
  "author": "Lila",
  "licence": "CC0-1.0",
  "version": "1.0",
  "description": "A worn painted footpath: warm ochre earth, scattered pebbles, soft dappled shade, grass creeping in from the edges.",
  "shadingModel": "painterly",
  "shading": {
   "shadingModel": "painterly",
   "strokeMap": "strokes_soft",
   "strokeScale": 20.0,
   "strokeNormal": 0.45,
   "paletteShadow": [
    0.1022,
    0.0513,
    0.117
   ],
   "paletteLight": [
    1.0,
    0.8714,
    0.5271
   ],
