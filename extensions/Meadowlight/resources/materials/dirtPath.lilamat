    0.7454,
    0.3515,
    0.117
   ],
   "paletteContrast": 0.4,
   "specularTint": 0.6
  }
 },
 "graph": {
  "name": "DirtPath",
  "typeVersion": 1,
  "description": "A worn painted footpath: warm ochre earth, scattered pebbles, soft dappled shade, grass creeping in from the edges.",
  "inputs": [
   {
    "name": "seed",
    "kind": "param",
    "type": "seed",
    "default": 0,
    "label": "Seed",
    "description": "Changes the pattern without changing the look.",
    "targets": [
     "Material.seed"
    ]
   },
   {
    "name": "wear",
    "kind": "param",
    "type": "float",
    "default": 0.3,
    "label": "Wear",
    "description": "Ruts and footworn hollows.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
     "Material.wear"
    ]
   },
   {
    "name": "age",
    "kind": "param",
    "type": "float",
    "default": 0.3,
    "label": "Age",
    "description": "Grass creeping in.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
     "Material.age"
    ]
   },
   {
    "name": "colorVariation",
    "kind": "param",
    "type": "float",
    "default": 0.5,
    "label": "Colour Variation",
    "description": "How much the colour wanders across the surface.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
     "Material.colorVariation"
    ]
   },
   {
    "name": "hue",
    "kind": "param",
    "type": "float",
    "default": 0.0,
    "label": "Hue",
    "description": "Shifts the base colour's hue, in turns.",
    "min": -0.5,
    "max": 0.5,
    "targets": [
     "Material.hue"
    ]
   }
  ],
  "nodes": [
   {
