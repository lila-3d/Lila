  "subgroups": {
   "PaintedPlaster": {
    "name": "PaintedPlaster",
    "typeVersion": 1,
    "description": "Cool whitewashed lime plaster: chalky white with lilac shadows, soft trowel swirls and a few painted cracks.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Trowel.seed",
       "Soft.seed",
       "Cracks.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.2,
      "label": "Wear",
      "description": "Softens the relief, as if worn down.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "WornRelief.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.3,
      "label": "Age",
      "description": "Painted cracks.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Surface.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Paint.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Trowel",
      "type": "gabor",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 3,
       "impulses": 6,
       "frequency": 0.8,
       "angleRandom": 1.0
      }
     },
     {
      "name": "Soft",
      "type": "clouds",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 3,
       "octaves": 5
      }
     },
     {
      "name": "Cracks",
      "type": "cells",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 4,
       "mode": "crackle",
       "width": 0.01,
       "jitter": 1.0
      }
     },
     {
      "name": "Surface",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float ck = texToFloat(c.sample(uv)) * smoothstep(0.7 - p.y * 0.4, 0.85 - p.y * 0.4, texToFloat(b.sample(uv)));\nreturn float4(texToFloat(a.sample(uv)), texToFloat(b.sample(uv)), ck, 1.0);",
       "y": 0.3
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float v = 0.5 + (a.sample(uv).x - 0.5) * 0.05 + (a.sample(uv).y - 0.5) * 0.06 - a.sample(uv).z * 0.05;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "ValueLight",
      "type": "emboss",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "angle": 135.0,
       "intensity": 1.0
      }
     },
     {
      "name": "ValueOcclusion",
      "type": "blur",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.02
      }
     },
     {
      "name": "Value",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float h = texToFloat(c.sample(uv));\nfloat l = texToFloat(a.sample(uv));\nfloat cav = saturate((texToFloat(b.sample(uv)) - h) * 8.0);\nfloat v = 0.5 + (l - 0.5) * 1.2000 + (h - 0.5) * 0.5 - cav * 0.8000 + 0.1000;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "WashValue",
      "type": "pixelProcessor",
      "position": [
       1200.0,
       0.0
      ],
      "values": {
       "expression": "float v = texToFloat(a.sample(uv)) + (b.sample(uv).y - 0.5) * 0.5;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Strokes",
      "type": "image",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "file": "strokes/strokes_soft.png",
       "tiles": 4
      }
     },
     {
      "name": "Paint",
      "type": "pixelProcessor",
      "position": [
       1440.0,
       0.0
      ],
      "values": {
       "expression": "float t = texToFloat(a.sample(uv));\nfloat4 s = b.sample(uv);\nt = saturate(t + (s.a - 0.5) * 0.2500 * (0.4 + p.z) + (s.b - 0.5) * 0.25);\nfloat k = t * 5.0000;\nt = (floor(k) + smoothstep(0.3, 0.7, frac(k))) / 5.0000;\nfloat3 c = t < 0.34 ? lerp(float3(0.4784, 0.4627, 0.6275), float3(0.7294, 0.7059, 0.8157), t / 0.34) : (t < 0.67 ? lerp(float3(0.7294, 0.7059, 0.8157), float3(0.9098, 0.8863, 0.8941), (t - 0.34) / 0.33) : lerp(float3(0.9098, 0.8863, 0.8941), float3(0.9843, 0.9647, 0.9255), (t - 0.67) / 0.33));\nreturn float4(c, 1.0);",
       "z": 0.5
      }
     },
     {
      "name": "CrackPaint",
      "type": "pixelProcessor",
      "position": [
       1680.0,
       0.0
      ],
      "values": {
       "expression": "float3 c0 = lerp(a.sample(uv).rgb, float3(0.3529, 0.3137, 0.4392), b.sample(uv).z * 0.8);\nreturn float4(c0, 1.0);"
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.9000 + (texToFloat(a.sample(uv)) - 0.5) * 0.05;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "WornRelief",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = 0.5 + (texToFloat(a.sample(uv)) - 0.5) * (1.0 - p.x * 0.6);\nreturn float4(v, v, v, 1.0);",
       "x": 0.2
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       960.0,
       160.0
      ],
      "values": {
       "intensity": 0.4
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       960.0,
       320.0
      ],
      "values": {
       "radius": 0.03,
       "depth": 0.1,
       "strength": 0.5
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       1920.0,
       0.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       2160.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       960.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       2640.0,
       0.0
      ],
      "values": {}
     }
    ],
    "links": [
