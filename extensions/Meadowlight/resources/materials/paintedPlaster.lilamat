  }
 },
 "graph": {
  "name": "PaintedPlaster",
  "typeVersion": 1,
  "description": "Cool whitewashed lime plaster: chalky white with lilac shadows, soft trowel swirls and a few painted cracks.",
  "inputs": [
   {
    "name": "seed",
    "kind": "param",
    "type": "seed",
    "default": 0,
    "label": "Seed",
    "description": "Changes the pattern without changing the look.",
    "targets": [
     "Material.seed"
    ]
   },
   {
    "name": "wear",
    "kind": "param",
    "type": "float",
    "default": 0.2,
    "label": "Wear",
    "description": "Softens the relief, as if worn down.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
     "Material.wear"
    ]
   },
   {
    "name": "age",
    "kind": "param",
    "type": "float",
    "default": 0.3,
    "label": "Age",
    "description": "Painted cracks.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
     "Material.age"
    ]
   },
   {
    "name": "colorVariation",
    "kind": "param",
    "type": "float",
    "default": 0.5,
    "label": "Colour Variation",
    "description": "How much the colour wanders across the surface.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
     "Material.colorVariation"
    ]
   },
   {
    "name": "hue",
    "kind": "param",
    "type": "float",
    "default": 0.0,
    "label": "Hue",
    "description": "Shifts the base colour's hue, in turns.",
    "min": -0.5,
    "max": 0.5,
    "targets": [
     "Material.hue"
    ]
   }
  ],
  "nodes": [
   {
    "name": "Material",
    "type": "Group",
    "position": [
     0.0,
     0.0
    ],
    "values": {
     "group": "PaintedPlaster",
     "seed": 0,
     "wear": 0.2,
     "age": 0.3,
     "colorVariation": 0.5,
     "hue": 0.0
    }
   },
   {
    "name": "Output",
