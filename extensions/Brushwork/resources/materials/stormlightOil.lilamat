  "subgroups": {
   "StormlightOil": {
    "name": "StormlightOil",
    "typeVersion": 1,
    "description": "Dramatic oils under a breaking storm: teal-black shadows, slate mid-tones and shafts of gold light.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "LightField.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Wear",
      "description": "Stroke relief: how thick the paint stands.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Height.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Age",
      "description": "Aged varnish: warmer, duller.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Palette.y",
       "Roughness.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.6,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Palette.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     }
    ],
    "outputs": [
     {
