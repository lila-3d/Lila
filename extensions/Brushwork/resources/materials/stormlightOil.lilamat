     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Strokes",
      "type": "image",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "file": "strokes/strokes_bristle.png",
       "tiles": 4
      }
     },
     {
      "name": "FineStrokes",
      "type": "image",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "file": "strokes/strokes_bristle.png",
       "tiles": 11
      }
     },
     {
      "name": "LightField",
      "type": "clouds",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 2,
       "octaves": 4,
       "persistence": 0.5
      }
     },
     {
      "name": "Palette",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat4 s2 = b.sample(uv);\nfloat t = texToFloat(c.sample(uv));\nt = saturate(0.5 + (t - 0.5) * 1.6 + (s.a - 0.5) * 0.4000 * (0.4 + p.z) + (s.b - 0.5) * 0.3 + (s2.b - 0.5) * 0.15);\nfloat k = t * 5.0000;\nt = (floor(k) + smoothstep(0.5 - 0.5 * 0.3500, 0.5 + 0.5 * 0.3500, frac(k))) / 5.0000;\nfloat3 cc = t < 0.34 ? lerp(float3(0.0784, 0.1490, 0.1647), float3(0.2275, 0.3216, 0.3451), t / 0.34) : (t < 0.67 ? lerp(float3(0.2275, 0.3216, 0.3451), float3(0.5412, 0.5412, 0.4157), (t - 0.34) / 0.33) : lerp(float3(0.5412, 0.5412, 0.4157), float3(0.9412, 0.7843, 0.3765), (t - 0.67) / 0.33));\nfloat gap = step(s.b, 0.0000 * 0.6) * 0.0000;\ncc = lerp(cc, float3(0.0784, 0.1490, 0.1647) * 0.85, gap);\ncc = lerp(cc, cc * float3(0.9098, 0.8235, 0.6275), p.y * 0.4);\nreturn float4(cc, 1.0);",
       "z": 0.6,
       "y": 0.0
      }
     },
     {
      "name": "StrokeTilt",
      "type": "pixelProcessor",
      "position": [
       240.0,
       160.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat4 s2 = b.sample(uv);\nfloat2 t = (s.rg - 0.5) * 2.0 + (s2.rg - 0.5) * 0.8;\nfloat3 n = normalize(float3(t * 0.8500, 1.0));\nreturn float4(n * 0.5 + 0.5, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       240.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.5 + (a.sample(uv).b - 0.5) * p.x * 0.2 + (b.sample(uv).b - 0.5) * p.x * 0.08;\nreturn float4(v, v, v, 1.0);",
       "x": 0.5
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       240.0,
       480.0
      ],
      "values": {
       "expression": "float v = 0.7000 + (a.sample(uv).b - 0.5) * 0.1 + p.y * 0.1;\nreturn float4(v, v, v, 1.0);",
       "y": 0.0
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "intensity": 0.6
      }
     },
     {
      "name": "DetailNormal",
      "type": "normalCombine",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "mode": "rnm"
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "radius": 0.01,
       "depth": 0.03,
       "strength": 0.4
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       480.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1200.0,
       0.0
      ],
      "values": {}
     }
    ],
