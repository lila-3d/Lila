# Precompiled headers and unity builds for every Lila target. Call lila_build_speed() once, after all targets exist.

option(LILA_PCH "Precompile the common standard, glm, json, TBB and Qt headers (src/core/Pch.h)" ON)
option(LILA_UNITY_BUILD "Compile each target's sources in batches" ON)
set(LILA_UNITY_BATCH_SIZE 8 CACHE STRING "Sources per unity batch")

# Sources that clash with their batch neighbours (same-named file-local helpers, using-directives), relative to the
# source root. Renaming the clash takes a file off this list.
include(LilaUnitySkip)

function(_lila_build_speed_targets dir out)
    get_property(targets DIRECTORY ${dir} PROPERTY BUILDSYSTEM_TARGETS)
    get_property(subdirs DIRECTORY ${dir} PROPERTY SUBDIRECTORIES)
    foreach(sub IN LISTS subdirs)
        _lila_build_speed_targets(${sub} sub_targets)
        list(APPEND targets ${sub_targets})
    endforeach()
    set(${out} ${targets} PARENT_SCOPE)
endfunction()

function(lila_build_speed)
    if(NOT LILA_PCH AND NOT LILA_UNITY_BUILD)
        return()
    endif()
    _lila_build_speed_targets(${CMAKE_SOURCE_DIR} targets)
    foreach(target IN LISTS targets)
        get_target_property(type ${target} TYPE)
        if(NOT type MATCHES "^(OBJECT_LIBRARY|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|EXECUTABLE)$")
            continue()
        endif()
        get_target_property(dir ${target} SOURCE_DIR)
        if(dir MATCHES "/_deps/")
            continue()
        endif()
        get_target_property(sources ${target} SOURCES)
        list(FILTER sources INCLUDE REGEX "\\.(cpp|cc|cxx)$")
        if(NOT sources)
            continue()
        endif()
        if(LILA_PCH)
            target_precompile_headers(${target} PRIVATE $<$<COMPILE_LANGUAGE:CXX>:${CMAKE_SOURCE_DIR}/src/core/Pch.h>)
        endif()
        if(LILA_UNITY_BUILD)
            set_target_properties(${target} PROPERTIES UNITY_BUILD ON UNITY_BUILD_BATCH_SIZE ${LILA_UNITY_BATCH_SIZE})
            if(MSVC)
                target_compile_options(${target} PRIVATE /bigobj)
            endif()
            foreach(source IN LISTS sources)
                cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY ${dir} OUTPUT_VARIABLE path)
                if(NOT EXISTS ${path})
                    continue()
                endif()
                cmake_path(RELATIVE_PATH path BASE_DIRECTORY ${CMAKE_SOURCE_DIR} OUTPUT_VARIABLE relative)
                # A single-header library's implementation define does nothing once another source in the batch has
                # included that header.
                file(STRINGS ${path} defines REGEX "^#[ \t]*define[ \t]+[A-Z_]*IMPLEMENT")
                if(defines OR relative IN_LIST LILA_UNITY_SKIP)
                    set_source_files_properties(${path} TARGET_DIRECTORY ${target} PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
                endif()
            endforeach()
        endif()
    endforeach()
endfunction()
