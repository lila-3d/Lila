# Install-time script: copies the headers the SDK's <lila/...> headers reach, transitively, into the package.
# Inputs: LILA_SDK_SOURCE (the source tree), LILA_SDK_DEST (the install's include/lila folder).
#   sdk/include/lila/*.h        -> <dest>/*.h
#   src/<module>/X.h they reach -> <dest>/internal/<module>/X.h (internal is on the SDK's include path)

cmake_policy(VERSION 3.28)

set(_sdk ${LILA_SDK_SOURCE}/sdk/include)
set(_src ${LILA_SDK_SOURCE}/src)
file(GLOB _queue ${_sdk}/lila/*.h)
set(_seen)

while(_queue)
    list(POP_FRONT _queue _file)
    if(_file IN_LIST _seen)
        continue()
    endif()
    list(APPEND _seen ${_file})
    cmake_path(GET _file PARENT_PATH _dir)
    file(STRINGS ${_file} _lines REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"]")
    foreach(_line ${_lines})
        if(NOT _line MATCHES "[<\"]([^>\"]+)[>\"]")
            continue()
        endif()
        set(_name ${CMAKE_MATCH_1})
        foreach(_base ${_dir} ${_sdk} ${_src})
            if(EXISTS ${_base}/${_name} AND NOT IS_DIRECTORY ${_base}/${_name})
                cmake_path(SET _found NORMALIZE ${_base}/${_name})
                list(APPEND _queue ${_found})
                break()
            endif()
        endforeach()
    endforeach()
endwhile()

set(_count 0)
foreach(_file ${_seen})
    cmake_path(IS_PREFIX _sdk ${_file} NORMALIZE _public)
    if(_public)
        cmake_path(RELATIVE_PATH _file BASE_DIRECTORY ${_sdk}/lila OUTPUT_VARIABLE _rel)
        set(_to ${LILA_SDK_DEST}/${_rel})
    else()
        cmake_path(RELATIVE_PATH _file BASE_DIRECTORY ${_src} OUTPUT_VARIABLE _rel)
        set(_to ${LILA_SDK_DEST}/internal/${_rel})
    endif()
    cmake_path(GET _to PARENT_PATH _toDir)
    file(MAKE_DIRECTORY ${_toDir})
    file(COPY_FILE ${_file} ${_to} ONLY_IF_DIFFERENT)
    math(EXPR _count "${_count} + 1")
endforeach()
message(STATUS "Lila SDK: ${_count} headers in ${LILA_SDK_DEST}")
