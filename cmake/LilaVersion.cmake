# Writes LilaBuildInfo.h with the version and build ID. Included from the top level it adds the lila_version target, which
# reruns this file in script mode on every build; the header is rewritten only when its contents change.
#   version  0.1.0
#   build    <commit time, UTC yyyyMMddHHmm>-<sha10>[-dirty]

if(NOT CMAKE_SCRIPT_MODE_FILE)
    set(LILA_BUILD_INFO_DIR ${CMAKE_BINARY_DIR}/generated)
    add_custom_target(lila_version
        COMMAND ${CMAKE_COMMAND} -DSOURCE_DIR=${CMAKE_SOURCE_DIR} -DOUT=${LILA_BUILD_INFO_DIR}/LilaBuildInfo.h
                -DVERSION=${PROJECT_VERSION} -DGIT=${GIT_EXECUTABLE} -P ${CMAKE_CURRENT_LIST_FILE}
        BYPRODUCTS ${LILA_BUILD_INFO_DIR}/LilaBuildInfo.h
        COMMENT "Stamping version")
    return()
endif()

function(git out)
    execute_process(COMMAND ${GIT} ${ARGN} WORKING_DIRECTORY ${SOURCE_DIR}
                    OUTPUT_VARIABLE value OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        set(value "")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

set(sha "")
if(GIT)
    git(sha rev-parse --short=10 HEAD)
endif()
if(sha)
    git(epoch log -1 --format=%ct)
    # string(TIMESTAMP) formats SOURCE_DATE_EPOCH instead of now when it is set.
    set(ENV{SOURCE_DATE_EPOCH} ${epoch})
    string(TIMESTAMP stamp "%Y%m%d%H%M" UTC)
    set(build "${stamp}-${sha}")
    git(changes status --porcelain --untracked-files=no)
    if(changes)
        string(APPEND build "-dirty")
    endif()
else()
    set(sha "unknown")
    set(build "unknown")
endif()

string(REPLACE "." ";" parts "${VERSION}")
list(GET parts 0 major)
list(GET parts 1 minor)
list(GET parts 2 patch)

set(text "// Generated by cmake/LilaVersion.cmake. Plain defines only: lila.rc includes it too.
#ifndef LILA_BUILD_INFO_H
#define LILA_BUILD_INFO_H
#define LILA_VERSION_MAJOR ${major}
#define LILA_VERSION_MINOR ${minor}
#define LILA_VERSION_PATCH ${patch}
#define LILA_VERSION \"${VERSION}\"
#define LILA_GIT_SHA \"${sha}\"
#define LILA_BUILD_ID \"${build}\"
#endif
")

set(old "")
if(EXISTS ${OUT})
    file(READ ${OUT} old)
endif()
if(NOT old STREQUAL text)
    file(WRITE ${OUT} "${text}")
endif()
