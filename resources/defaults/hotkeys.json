{
  "holdDelayMs": 180,
  "contexts": {
    "global": {
      "Ctrl+Z": "edit.undo",
      "Z": "edit.undo",
      "Shift+Z": "edit.redo",
      "Ctrl+Y": "edit.redo",
      "Ctrl+Shift+Z": "edit.redo",
      "Delete": "edit.delete",
      "Backspace": "edit.delete",
      "Ctrl+G": "edit.group",
      "Ctrl+D": "edit.duplicate",
      "Alt+Shift+D": "mesh.deleteHistory",
      "H": "display.toggleVisibility",
      "T": "select.hierarchy",
      "Ctrl+H": "display.hide",
      "Ctrl+M": "window.modifierStack",
      "Shift+H": "display.show",
      "Ctrl+Shift+H": "display.showAll",
      "P": "edit.parent",
      "Shift+P": "edit.unparent",
      "Ctrl+Shift+P": "edit.parentChain",
      "Ctrl+A": "window.toggleChannelBox",
      "Ctrl+Shift+A": "edit.deselect",
      "Ctrl+N": "file.new",
      "Ctrl+O": "file.open",
      "Ctrl+S": "file.save",
      "Ctrl+Shift+S": "file.saveAs",
      "Ctrl+Alt+S": "file.incrementAndSave",
      "Ctrl+Shift+O": "file.openFolder",
      "Alt+R": "file.createReference",
      "Ctrl+Alt+R": "window.referenceEditor",
      "Ctrl+Q": "file.exit",
      "Ctrl+Space": "window.toggleMaximizePanel",
      "Ctrl+,": "window.preferences",
      "Up": "select.pickWalkUp",
      "Down": "select.pickWalkDown",
      "Left": "select.pickWalkLeft",
      "Right": "select.pickWalkRight",
      "F2": "edit.rename",
      "`": { "press": "shelf.floatingOpen", "release": "shelf.floatingRelease" },
      "Shift+`": "select.objectMode",
      "Shift+1": "select.vertexMode",
      "Shift+2": "select.edgeMode",
      "Shift+3": "select.faceMode",
      "U": "window.toggleUvEditor",
      "F1": { "press": "help.hotkeyCheatSheet", "release": "help.hotkeyCheatSheetClose" },
      "Shift+F1": "window.layout.modeling",
      "Shift+F2": "window.layout.uvEditing",
      "Shift+F3": "window.layout.rigging",
      "Shift+F4": "window.layout.animation",
      "Shift+F5": "window.layout.scripting",
      "F10": "window.resetLayout",
      "S": "anim.setKey",
      "Shift+W": "anim.setKeyTranslate",
      "Shift+E": "anim.setKeyRotate",
      "Shift+R": "anim.setKeyScale",
      "Alt+.": "anim.nextFrame",
      "Alt+,": "anim.prevFrame",
      ".": "anim.nextKey",
      ",": "anim.prevKey",
      "Shift+.": "select.grow",
      "Shift+,": "select.shrink",
      "[": "viewport.cameraUndo",
      "]": "viewport.cameraRedo",
      "Alt+V": "anim.play",
      "Ctrl+Shift+T": "window.modelingToolkit",
      "Shift+G": "adjustLastOp.show"
    },
    "viewport": {
      "F": "viewport.frameSelected",
      "M": "measure.selection",
      "Ctrl+1": "viewport.isolate",
      "A": "viewport.frameAll",
      "F8": "select.objectMode",
      "F9": "select.vertexMode",
      "F11": "select.faceMode",
      "Ctrl+E": "mesh.extrude",
      "Ctrl+B": "mesh.bevel",
      "I": "mesh.inset",
      "Ctrl+R": "mesh.insertLoop",
      "Ctrl+Shift+M": "mesh.merge",
      "1": "display.smoothOff",
      "2": "display.smoothCage",
      "3": "display.smoothOn",
      "4": "viewport.wireframe",
      "5": "viewport.shaded",
      "6": "viewport.textured",
      "Ctrl+6": "viewport.wireOnShaded",
      "B": { "press": "softSelect.keyDown", "release": "softSelect.keyUp" },
      "Q": { "press": "tool.select", "LMB": { "markingMenu": "selectTool" } },
      "W": { "press": "tool.move", "LMB": { "markingMenu": "moveTool" } },
      "E": { "press": "tool.rotate", "LMB": { "markingMenu": "rotateTool" } },
      "R": { "press": "tool.scale", "LMB": { "markingMenu": "scaleTool" } },
      "D": { "press": "tool.pivotEditOn", "release": "tool.pivotEditOff" },
      "Insert": "tool.pivotEditToggle",
      "X": { "press": "snap.gridOn", "release": "snap.gridOff" },
      "C": { "press": "snap.edgeOn", "release": "snap.edgeOff" },
      "V": { "press": "snap.vertexOn", "release": "snap.vertexOff" },
      "J": { "press": "snap.rotateHoldOn", "release": "snap.rotateHoldOff" },
      "Space": { "press": "viewport.toggleQuad", "hold": "hotbox.show" },
      "Esc": "anim.stop"
    },
    "timeSlider": {
      "Esc": "anim.stop"
    },
    "outliner": {
      "F": "outliner.revealSelected",
      "F2": "outliner.rename"
    },
    "nodeEditor": {
      "Tab": "nodeEditor.addNode",
      "Shift+A": "nodeEditor.addNode",
      "Delete": "nodeEditor.delete",
      "Backspace": "nodeEditor.delete",
      "X": "nodeEditor.delete",
      "Ctrl+C": "nodeEditor.copy",
      "Ctrl+X": "nodeEditor.cut",
      "Ctrl+V": "nodeEditor.paste",
      "Ctrl+D": "nodeEditor.duplicate",
      "Shift+D": "nodeEditor.duplicate",
      "A": "nodeEditor.selectAll",
      "F": "nodeEditor.frameSelected",
      "Home": "nodeEditor.frameAll"
    },
    "graphEditor": {
      "F": "graphEditor.frameSelected",
      "A": "graphEditor.frameAll",
      "Delete": "anim.deleteKeys",
      "Backspace": "anim.deleteKeys",
      "Esc": "anim.stop"
    }
  }
}
