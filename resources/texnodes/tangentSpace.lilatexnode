{
  "format": "lilatexnode",
  "version": 1,
  "type": "tangentSpace",
  "label": "Tangent Space",
  "category": "Input",
  "doc": "The mesh's object-space tangent frame per texel from the mesh maps (unit vectors); (u, v, 0) when not supplied.",
  "inputs": [],
  "outputs": [
    {
      "id": "tangent",
      "type": "vector"
    },
    {
      "id": "bitangent",
      "type": "vector"
    },
    {
      "id": "normal",
      "type": "vector"
    }
  ],
  "params": [],
  "cost": 1,
  "externals": [
    "tangent",
    "bitangent",
    "normal"
  ],
  "body": {
    "tangent": "return tangent.sample(uv).xyz;",
    "bitangent": "return bitangent.sample(uv).xyz;",
    "normal": "return normal.sample(uv).xyz;"
  }
}
