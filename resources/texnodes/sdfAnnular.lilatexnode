{
  "format": "lilatexnode",
  "version": 1,
  "type": "sdfAnnular",
  "label": "SDF Annular",
  "category": "SDF",
  "doc": "Turns a shape into its outline: a band of the given thickness (uv) centred on the edge.",
  "inputs": [
    {
      "id": "input",
      "type": "sdf2d",
      "default": 1.0
    }
  ],
  "outputs": [
    {
      "id": "sdf",
      "type": "sdf2d"
    }
  ],
  "params": [
    {
      "id": "thickness",
      "type": "float",
      "default": 0.02,
      "min": 0,
      "softMax": 0.2
    }
  ],
  "cost": 1,
  "body": {
    "sdf": "return abs(input.sample(uv)) - p.thickness * 0.5;"
  }
}
