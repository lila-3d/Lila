{
  "format": "lilatexnode",
  "version": 1,
  "type": "clamp",
  "label": "Clamp",
  "category": "Filter",
  "doc": "Limits every colour channel to a range.",
  "inputs": [
    {
      "id": "input",
      "type": "color",
      "default": [
        0.5,
        0.5,
        0.5,
        1
      ]
    }
  ],
  "outputs": [
    {
      "id": "out",
      "type": "color"
    }
  ],
  "params": [
    {
      "id": "low",
      "type": "float",
      "default": 0.0,
      "softMin": 0,
      "softMax": 1
    },
    {
      "id": "high",
      "type": "float",
      "default": 1.0,
      "softMin": 0,
      "softMax": 1
    }
  ],
  "cost": 1,
  "body": {
    "out": "float4 c = input.sample(uv);\nreturn float4(clamp(c.rgb, p.low, p.high), c.a);"
  }
}
