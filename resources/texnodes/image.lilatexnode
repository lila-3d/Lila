{
  "format": "lilatexnode",
  "version": 1,
  "type": "image",
  "label": "Image",
  "category": "Input",
  "doc": "An image file sampled in uv, wrapping at the edges, repeated tiles times. Relative paths resolve against the workspace, the scene's folder, then Lila's resources (strokes/strokes_soft.png names a shipped stroke sheet). The set samples the image at the set's resolution: when the image is larger, Match Set on the node raises the set to fit. To show an image on an object without authoring maps, set it as a material's map in the Material Editor instead.",
  "inputs": [],
  "outputs": [
    {
      "id": "out",
      "type": "color"
    }
  ],
  "params": [
    {
      "id": "file",
      "type": "image",
      "default": ""
    },
    {
      "id": "tiles",
      "type": "int",
      "default": 1,
      "min": 1,
      "softMax": 16,
      "doc": "Repeats across the texture."
    }
  ],
  "cost": 2,
  "body": {
    "out": "return file.sample(uv * float(p.tiles));"
  }
}
