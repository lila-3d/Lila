{
  "format": "lilatexnode",
  "version": 1,
  "type": "cells",
  "label": "Cells",
  "category": "Noise",
  "doc": "Voronoi variants: flat random cells, crackle (thin lines along cell edges), F2 - F1, F1 or F2, with euclidean, manhattan or chebyshev distance. Tileable.",
  "inputs": [],
  "outputs": [
    {
      "id": "out",
      "type": "gray"
    },
    {
      "id": "random",
      "type": "gray"
    },
    {
      "id": "color",
      "type": "color"
    }
  ],
  "params": [
    {
      "id": "scale",
      "type": "int",
      "default": 6,
      "min": 1,
      "softMax": 64,
      "doc": "Cells across the texture."
    },
    {
      "id": "jitter",
      "type": "float",
      "default": 1.0,
      "min": 0,
      "max": 1,
      "doc": "0 is a regular grid."
    },
    {
      "id": "mode",
      "type": "enum",
      "default": "cells",
      "options": [
        "cells",
        "crackle",
        "f2MinusF1",
        "f1",
        "f2"
      ]
    },
    {
      "id": "metric",
      "type": "enum",
      "default": "euclidean",
      "options": [
        "euclidean",
        "manhattan",
        "chebyshev"
      ]
    },
    {
      "id": "width",
      "type": "float",
      "default": 0.08,
      "min": 0,
      "softMax": 0.5,
      "doc": "Crackle line width, in cells."
    },
    {
      "id": "seed",
      "type": "seed",
      "default": 0,
      "doc": "Changes the pattern without changing its look."
    }
  ],
  "cost": 70,
  "helpers": [
    "cellular"
  ],
  "code": "float cellsValue(CellResult r, int mode, float width, uint seed)\n{\n    if (mode == 0)\n        return cellRandom(r, seed);\n    if (mode == 1)\n        return 1.0 - smoothstep(0.0, max(width, 1e-4), cellEdgeDistance(r));\n    if (mode == 2)\n        return saturate(r.f2 - r.f1);\n    if (mode == 3)\n        return saturate(r.f1);\n    return saturate(r.f2 * 0.75);\n}",
  "body": {
    "out": "CellResult r = cellular(uv, int2(p.scale, p.scale), p.jitter, p.metric, uint(p.seed));\nreturn cellsValue(r, p.mode, p.width, uint(p.seed));",
    "random": "CellResult r = cellular(uv, int2(p.scale, p.scale), p.jitter, p.metric, uint(p.seed));\nreturn cellRandom(r, uint(p.seed));",
    "color": "CellResult r = cellular(uv, int2(p.scale, p.scale), p.jitter, p.metric, uint(p.seed));\nreturn cellColor(r, uint(p.seed));"
  }
}
