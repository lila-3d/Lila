{
  "format": "lilatexnode",
  "version": 1,
  "type": "directionalBlur",
  "label": "Directional Blur",
  "category": "Filter",
  "doc": "Smears the input along an angle, 16 samples spread over the length (uv) centred on each texel.",
  "inputs": [
    {
      "id": "input",
      "type": "color",
      "default": [
        0.5,
        0.5,
        0.5,
        1
      ],
      "taps": 16
    }
  ],
  "outputs": [
    {
      "id": "out",
      "type": "color"
    }
  ],
  "params": [
    {
      "id": "angle",
      "type": "float",
      "default": 0.0,
      "softMin": -180,
      "softMax": 180,
      "doc": "Degrees."
    },
    {
      "id": "length",
      "type": "float",
      "default": 0.05,
      "min": 0,
      "softMax": 0.5
    }
  ],
  "cost": 20,
  "body": {
    "out": "float a = radians(p.angle);\nfloat2 d = float2(cos(a), sin(a)) * p.length;\nfloat4 acc = float4(0.0, 0.0, 0.0, 0.0);\nfor (int i = 0; i < 16; ++i)\n    acc += input.sample(uv + d * ((float(i) + 0.5) / 16.0 - 0.5));\nreturn acc / 16.0;"
  }
}
