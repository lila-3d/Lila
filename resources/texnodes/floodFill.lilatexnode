{
  "format": "lilatexnode",
  "version": 1,
  "type": "floodFill",
  "label": "Flood Fill",
  "category": "Fill",
  "doc": "Finds the separate white regions of a mask (joined across the texture's edges) and stores each texel's region box, for the Fill To nodes. Feed those directly: they read it at its own resolution. Runs as its own pass.",
  "kind": "native",
  "inputs": [
    {
      "id": "input",
      "type": "gray",
      "default": 0.0,
      "doc": "Regions are where this is over 0.5."
    }
  ],
  "outputs": [
    {
      "id": "out",
      "type": "color"
    }
  ],
  "params": [
    {
      "id": "passes",
      "type": "int",
      "default": 4,
      "min": 1,
      "max": 64,
      "doc": "GPU sweeps; more resolve winding regions. The CPU result is always exact."
    }
  ],
  "cost": 40
}
