{
  "format": "lilatexnode",
  "version": 1,
  "type": "triplanar",
  "label": "Triplanar",
  "category": "Input",
  "doc": "Projects the input onto the mesh from three axes in object or world space, blended by the surface normal, so it needs no uvs and has no seams.",
  "inputs": [
    {
      "id": "input",
      "type": "color",
      "default": [
        0.5,
        0.5,
        0.5,
        1
      ],
      "taps": 3
    }
  ],
  "outputs": [
    {
      "id": "out",
      "type": "color"
    }
  ],
  "params": [
    {
      "id": "space",
      "type": "enum",
      "default": "object",
      "options": [
        "object",
        "world"
      ]
    },
    {
      "id": "scale",
      "type": "float",
      "default": 1.0,
      "min": 0,
      "softMax": 16,
      "doc": "Repeats per unit."
    },
    {
      "id": "sharpness",
      "type": "float",
      "default": 4.0,
      "min": 1,
      "softMax": 32,
      "doc": "How quickly the projections hand over."
    }
  ],
  "cost": 12,
  "externals": [
    "position",
    "normal",
    "worldPosition",
    "worldNormal"
  ],
  "body": {
    "out": "float3 pos = (p.space == 0 ? position.sample(uv).xyz : worldPosition.sample(uv).xyz) * p.scale;\nfloat3 n = p.space == 0 ? normal.sample(uv).xyz : worldNormal.sample(uv).xyz;\nfloat3 w = pow(abs(n) + 1e-5, float3(p.sharpness, p.sharpness, p.sharpness));\nw /= w.x + w.y + w.z;\nreturn input.sample(pos.yz) * w.x + input.sample(pos.xz) * w.y + input.sample(pos.xy) * w.z;"
  }
}
