{
  "format": "lilatexnode",
  "version": 1,
  "type": "histogramRange",
  "label": "Histogram Range",
  "category": "Filter",
  "doc": "Squeezes the values into a narrower range around a position: range 1 leaves them, 0 flattens to the position.",
  "inputs": [
    {
      "id": "input",
      "type": "gray",
      "default": 0.5
    }
  ],
  "outputs": [
    {
      "id": "out",
      "type": "gray"
    }
  ],
  "params": [
    {
      "id": "range",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "position",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    }
  ],
  "cost": 1,
  "body": {
    "out": "return saturate(p.position + (input.sample(uv) - 0.5) * p.range);"
  }
}
