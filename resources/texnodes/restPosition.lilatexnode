{
  "format": "lilatexnode",
  "version": 1,
  "type": "restPosition",
  "label": "Rest Position",
  "category": "Input",
  "doc": "Bind-pose (rest) object position from the mesh maps, so patterns stick to skinned and deformed meshes; (u, v, 0) when not supplied.",
  "inputs": [],
  "outputs": [
    {
      "id": "position",
      "type": "vector"
    }
  ],
  "params": [],
  "cost": 1,
  "externals": [
    "restPosition"
  ],
  "body": {
    "position": "return restPosition.sample(uv).xyz;"
  }
}
