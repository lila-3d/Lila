{
  "format": "lilatexnode",
  "version": 1,
  "type": "heightToNormal",
  "label": "Height to Normal",
  "category": "Normal",
  "doc": "A tangent-space normal (OpenGL, green up) from the slope of a height. Exports convert to the preset's convention.",
  "inputs": [
    {
      "id": "height",
      "type": "gray",
      "default": 0.5,
      "taps": 4
    }
  ],
  "outputs": [
    {
      "id": "normal",
      "type": "color"
    }
  ],
  "params": [
    {
      "id": "intensity",
      "type": "float",
      "default": 1.0,
      "softMin": 0,
      "softMax": 8
    }
  ],
  "cost": 8,
  "helpers": [
    "normals"
  ],
  "body": {
    "normal": "float2 e = texel();\nfloat l = height.sample(uv - float2(e.x, 0.0));\nfloat r = height.sample(uv + float2(e.x, 0.0));\nfloat d = height.sample(uv - float2(0.0, e.y));\nfloat t = height.sample(uv + float2(0.0, e.y));\nfloat2 g = float2(r - l, t - d) / (2.0 * e);\nreturn normalEncode(float3(-g * p.intensity * 0.05, 1.0));"
  }
}
