{
  "format": "lilatexnode",
  "version": 1,
  "type": "sdfRound",
  "label": "SDF Round",
  "category": "SDF",
  "doc": "Grows a signed distance outwards by a radius (uv), rounding its corners. Negative radii shrink it.",
  "inputs": [
    {
      "id": "input",
      "type": "sdf2d",
      "default": 1.0
    }
  ],
  "outputs": [
    {
      "id": "sdf",
      "type": "sdf2d"
    }
  ],
  "params": [
    {
      "id": "radius",
      "type": "float",
      "default": 0.02,
      "softMin": -0.1,
      "softMax": 0.1
    }
  ],
  "cost": 1,
  "body": {
    "sdf": "return input.sample(uv) - p.radius;"
  }
}
