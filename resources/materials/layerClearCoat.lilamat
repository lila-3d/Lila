    ],
    "nodes": [
     {
      "name": "Peel",
      "type": "perlin",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 64,
       "octaves": 2
      }
     },
     {
      "name": "Swirls",
      "type": "scratches",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 8,
       "count": 6,
       "length": 0.3,
       "width": 0.0006,
       "angleRandom": 1.0
      }
     },
     {
      "name": "Base",
      "type": "color",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "color": "#808080"
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float v = 0.04 + c.sample(uv) * p.x * 0.3 + p.y * 0.2 + (d.sample(uv) - 0.5) * 0.02 * (0.5 + p.z);\nreturn float4(v, v, v, 1.0);",
       "x": 0.15,
       "y": 0.1,
       "z": 0.5
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       240.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.5 + (d.sample(uv) - 0.5) * 0.003;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "intensity": 0.5
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "radius": 0.005,
       "depth": 0.01,
       "strength": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       240.0,
       320.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
