   "LayerClearCoat": {
    "name": "LayerClearCoat",
    "typeVersion": 1,
    "description": "A glossy clear lacquer as a layer: changes only roughness and adds a faint orange peel, over any base.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Peel.seed",
       "Swirls.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.15,
      "label": "Wear",
      "description": "Swirl marks and scuffs.",
