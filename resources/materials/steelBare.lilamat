  "subgroups": {
   "SteelBare": {
    "name": "SteelBare",
    "typeVersion": 1,
    "description": "Clean mild steel: soft mottling, fine handling scratches, tarnish and grime as it ages.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Mottle.seed",
       "Fine.seed",
       "Scratches.seed",
       "FineScratches.seed",
       "Grime.seed",
       "Pits.seed"
      ]
     },
     {
      "name": "wear",
