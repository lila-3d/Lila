     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Mottle",
      "type": "clouds",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 3,
       "octaves": 6,
       "persistence": 0.55
      }
     },
     {
      "name": "Fine",
      "type": "perlin",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 24,
       "octaves": 4,
       "persistence": 0.5
      }
     },
     {
      "name": "Scratches",
      "type": "scratches",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 5,
       "count": 4,
       "length": 0.7,
       "width": 0.0012,
       "angle": 25.0,
       "angleRandom": 1.0
      }
     },
     {
      "name": "FineScratches",
      "type": "scratches",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 11,
       "count": 6,
       "length": 0.35,
       "width": 0.0007,
       "angle": 70.0,
       "angleRandom": 1.0
      }
     },
     {
      "name": "Surface",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float s = max(c.sample(uv), d.sample(uv) * 0.7) * 1.0000;\nfloat worn = saturate(s * smoothstep(0.0, 0.6, p.x) * 1.6);\nreturn float4(a.sample(uv).r, b.sample(uv).r, worn, 1.0);",
       "x": 0.35
      }
     },
     {
      "name": "Grime",
      "type": "dirt",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "scale": 5,
       "amount": 0.5,
       "contrast": 1.0,
       "grain": 0.4
      }
     },
     {
      "name": "Pits",
      "type": "voronoi",
      "position": [
       0.0,
       800.0
      ],
      "values": {
       "scale": 28,
       "jitter": 0.9
      }
     },
     {
      "name": "Age",
      "type": "pixelProcessor",
      "position": [
       240.0,
       160.0
      ],
      "values": {
       "expression": "float g = texToFloat(a.sample(uv));\nfloat t = texToFloat(b.sample(uv));\nfloat pit = (1.0 - smoothstep(0.05, 0.2 + d.sample(uv) * 0.2, c.sample(uv))) * step(0.82, d.sample(uv)) * 0.0000;\nfloat grime = smoothstep(1.0 - (p.x * 0.7) * (1.0 + 0.2500), 1.0 - (p.x * 0.7) * (1.0 + 0.2500) + 0.2500, g);\nfloat tarnish = smoothstep(1.0 - (p.x) * (1.0 + 0.3500), 1.0 - (p.x) * (1.0 + 0.3500) + 0.3500, 1.0 - t);\nreturn float4(grime, tarnish, pit, 1.0);",
       "x": 0.15
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat4 g = b.sample(uv);\nfloat3 c0 = float3(0.7765, 0.7843, 0.7882) * (1.0 + (s.x - 0.5) * 0.1200 * (0.5 + p.z)) * (1.0 + (s.y - 0.5) * 0.06);\nc0 = lerp(c0, float3(0.6118, 0.5961, 0.5765), g.y * 0.85);\nc0 = lerp(c0, float3(0.7765, 0.7843, 0.7882), s.z * 0.8);\nc0 = lerp(c0, c0 * 0.8, g.z);\nc0 = lerp(c0, float3(0.2902, 0.2549, 0.2235), g.x);\nreturn float4(saturate(c0), 1.0);",
       "z": 0.5
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat4 g = b.sample(uv);\nfloat r = lerp(0.3000, 0.4500, saturate(s.x * 0.6 + s.y * 0.6 - 0.1));\nr = lerp(r, r + 0.15, g.y);\nr = lerp(r, max(r - 0.08, 0.04), s.z);\nr = lerp(r, 0.7, g.z);\nr = lerp(r, 0.85, g.x);\nreturn float4(r, r, r, 1.0);"
      }
     },
     {
      "name": "MetalMask",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float4 g = b.sample(uv);\nfloat v = 1.0 - smoothstep(0.45, 0.55, g.x) - smoothstep(0.55, 0.65, g.y) * 0.0000;\nv = saturate(v);\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       480.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat4 g = b.sample(uv);\nfloat h = 0.5 + (s.y - 0.5) * 0.0100 - s.z * 0.06 - g.z * 0.12 + g.x * 0.015;\nreturn float4(h, h, h, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 0.3
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.01,
       "depth": 0.05,
       "strength": 0.6
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1200.0,
       0.0
      ],
      "values": {}
     }
    ],
