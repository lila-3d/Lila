      "label": "Wear",
      "description": "Scratches and worn spots.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Surface.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.15,
      "label": "Age",
      "description": "Tarnish and grime.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Age.x"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.z"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
