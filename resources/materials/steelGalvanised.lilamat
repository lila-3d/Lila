   "SteelGalvanised": {
    "name": "SteelGalvanised",
    "typeVersion": 1,
    "description": "Hot-dip galvanised steel: zinc spangle crystals of varying sheen, whitening with zinc oxide as it ages.",
    "inputs": [
     {
      "name": "seed",
