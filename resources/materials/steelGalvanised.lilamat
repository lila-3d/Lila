    ],
    "nodes": [
     {
      "name": "Spangle",
      "type": "cells",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 7,
       "mode": "cells",
       "jitter": 1.0
      }
     },
     {
      "name": "SpangleFine",
      "type": "cells",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 19,
       "mode": "cells",
       "jitter": 1.0
      }
     },
     {
      "name": "Bloom",
      "type": "clouds",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 4,
       "octaves": 6
      }
     },
     {
      "name": "Scratches",
      "type": "scratches",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 6,
       "count": 3,
       "length": 0.6,
       "width": 0.001,
       "angleRandom": 1.0
      }
     },
     {
      "name": "Zinc",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float s = texToFloat(a.sample(uv)) * 0.7 + texToFloat(b.sample(uv)) * 0.3;\nfloat o = smoothstep(1.0 - p.x, 1.0 - p.x + 0.3, c.sample(uv));\nfloat w = d.sample(uv) * smoothstep(0.0, 0.5, p.y);\nreturn float4(s, o, w, 1.0);",
       "x": 0.3,
       "y": 0.2
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat3 z = float3(0.8392, 0.8549, 0.8627) * (0.9 + s.x * 0.16 * (0.5 + p.z));\nz = lerp(z, float3(0.7882, 0.7922, 0.7765), s.y * 0.9);\nreturn float4(saturate(z), 1.0);",
       "z": 0.5
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = lerp(lerp(0.18, 0.5, a.sample(uv).x), 0.75, a.sample(uv).y) - a.sample(uv).z * 0.1;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "MetalMask",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = 1.0 - smoothstep(0.65, 0.75, a.sample(uv).y);\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       480.0
      ],
      "values": {
       "expression": "float v = 0.5 + a.sample(uv).x * 0.01 + a.sample(uv).y * 0.01 - a.sample(uv).z * 0.04;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 0.3
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.01,
       "depth": 0.03,
       "strength": 0.4
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1200.0,
       0.0
      ],
      "values": {}
