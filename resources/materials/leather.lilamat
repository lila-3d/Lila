  "subgroups": {
   "Leather": {
    "name": "Leather",
    "typeVersion": 1,
    "description": "Pebble-grain cowhide: rounded grain, fine creases, waxy sheen that burnishes with handling.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Pebble.seed",
       "Creases.seed",
       "Creases2.seed",
       "Tone.seed",
       "Burnish.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.3,
      "label": "Wear",
      "description": "Burnished, lighter handled areas.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.x",
       "Roughness.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.2,
      "label": "Age",
      "description": "Dry cracking.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Grain.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
