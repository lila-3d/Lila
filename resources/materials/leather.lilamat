     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Pebble",
      "type": "cells",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 40,
       "mode": "f2MinusF1",
       "jitter": 1.0
      }
     },
     {
      "name": "Creases",
      "type": "directional",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "angle": 35.0,
       "scaleAlong": 3,
       "scaleAcross": 24,
       "octaves": 4
      }
     },
     {
      "name": "Creases2",
      "type": "directional",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "angle": 125.0,
       "scaleAlong": 3,
       "scaleAcross": 30,
       "octaves": 4
      }
     },
     {
      "name": "Tone",
      "type": "clouds",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 4,
       "octaves": 6
      }
     },
     {
      "name": "Grain",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float e = c.sample(uv);\nfloat dome = sqrt(saturate(e / 0.4));\nfloat k1 = texToFloat(a.sample(uv));\nfloat k2 = texToFloat(b.sample(uv));\nfloat cr = (1.0 - smoothstep(0.0, 0.05, abs(k1 - 0.5))) * 0.6 + (1.0 - smoothstep(0.0, 0.04, abs(k2 - 0.5))) * 0.4;\ncr *= 0.6 + p.y;\nreturn float4(dome, saturate(cr), d.sample(uv), 1.0);",
       "y": 0.2
      }
     },
     {
      "name": "Burnish",
      "type": "clouds",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "scale": 3,
       "octaves": 5
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat br = smoothstep(1.0 - p.x * 0.7, 1.25 - p.x * 0.7, texToFloat(b.sample(uv)));\nfloat3 c0 = lerp(float3(0.2902, 0.1725, 0.1020), float3(0.4314, 0.2667, 0.1569), saturate(s.z * 0.8 + s.x * 0.35 + (s.z - 0.5) * p.z));\nc0 = lerp(c0, float3(0.5412, 0.3529, 0.2118), br * 0.6 * s.x);\nc0 = lerp(c0, c0 * 0.6, s.y);\nreturn float4(c0, 1.0);",
       "z": 0.5,
       "x": 0.3
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat br = smoothstep(1.0 - p.x * 0.7, 1.25 - p.x * 0.7, texToFloat(b.sample(uv)));\nfloat r = lerp(0.62, 0.45, s.x) - br * 0.15 + s.y * 0.15;\nreturn float4(r, r, r, 1.0);",
       "x": 0.3
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.4 + a.sample(uv).x * 0.15 - a.sample(uv).y * 0.12;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 0.8
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.005,
       "depth": 0.05,
       "strength": 0.6
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       800.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1440.0,
       0.0
      ],
      "values": {}
     }
    ],
