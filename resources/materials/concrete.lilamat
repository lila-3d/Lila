  "subgroups": {
   "Concrete": {
    "name": "Concrete",
    "typeVersion": 1,
    "description": "Board-free cast concrete: cloudy grey, pinhole air voids, a few exposed aggregate patches and rain streaks.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Blotches.seed",
       "Voids.seed",
       "Aggregate.seed",
       "WearPatches.seed",
       "Streaks.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.25,
      "label": "Wear",
      "description": "Exposed aggregate where the skin wore off.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Surface.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.3,
      "label": "Age",
      "description": "Rain streaks and stains.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Blotches",
      "type": "clouds",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 4,
       "octaves": 7,
       "persistence": 0.58
      }
     },
     {
      "name": "Voids",
      "type": "worley",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 40,
       "octaves": 1
      }
     },
     {
      "name": "Aggregate",
      "type": "cells",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 60,
       "mode": "cells",
       "jitter": 1.0
      }
     },
     {
      "name": "WearPatches",
      "type": "perlin",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 5,
       "octaves": 6,
       "persistence": 0.6
      }
     },
     {
      "name": "Surface",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float cl = texToFloat(a.sample(uv));\nfloat v = 1.0 - smoothstep(0.0, 0.07, c.sample(uv));\nfloat hole = v * step(0.6, texToFloat(b.sample(uv + 0.3)));\nfloat pa = smoothstep(0.82 - p.x * 0.3, 0.86 - p.x * 0.3, d.sample(uv));\nreturn float4(cl, hole, pa, texToFloat(b.sample(uv)));",
       "x": 0.25
      }
     },
     {
      "name": "Streaks",
      "type": "directional",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "angle": 90.0,
       "scaleAlong": 2,
       "scaleAcross": 36,
       "octaves": 4
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat3 c0 = float3(0.5608, 0.5529, 0.5333) * (0.9 + (s.x - 0.5) * 0.25 * (0.5 + p.z) + 0.1);\nfloat3 ag = lerp(float3(0.4314, 0.4157, 0.3922), float3(0.6627, 0.6431, 0.6039), s.w);\nc0 = lerp(c0, ag, s.z * 0.85);\nc0 = lerp(c0, c0 * 0.6, s.y);\nfloat st = smoothstep(0.55, 0.8, texToFloat(b.sample(uv))) * p.y;\nc0 = lerp(c0, c0 * 0.72, st);\nreturn float4(c0, 1.0);",
       "z": 0.5,
       "y": 0.3
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.82 + (a.sample(uv).x - 0.5) * 0.1 + a.sample(uv).z * 0.06;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.5 + (a.sample(uv).x - 0.5) * 0.02 - a.sample(uv).y * 0.08 + a.sample(uv).z * (a.sample(uv).w - 0.5) * 0.06;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 0.8
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.01,
       "depth": 0.04,
       "strength": 0.6
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       800.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1440.0,
       0.0
      ],
      "values": {}
     }
    ],
    "links": [
