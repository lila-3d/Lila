  "subgroups": {
   "Snow": {
    "name": "Snow",
    "typeVersion": 1,
    "description": "Soft wind-shaped fresh snow: gentle drifts, faint sastrugi, glinting crystals, blue in the hollows.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
