    ],
    "nodes": [
     {
      "name": "Drifts",
      "type": "clouds",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 3,
       "octaves": 6,
       "persistence": 0.5
      }
     },
     {
      "name": "Sastrugi",
      "type": "directional",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "angle": 15.0,
       "scaleAlong": 2,
       "scaleAcross": 14,
       "octaves": 4
      }
     },
     {
      "name": "Glints",
      "type": "cells",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 120,
       "mode": "cells",
       "jitter": 1.0
      }
     },
     {
      "name": "Grime",
      "type": "dirt",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 6,
       "amount": 0.5,
       "contrast": 1.0,
       "grain": 0.4
      }
     },
     {
      "name": "Surface",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float d0 = texToFloat(a.sample(uv));\nfloat w = texToFloat(b.sample(uv));\nfloat hgt = d0 * 0.8 + w * 0.2;\nfloat gl = step(0.985, c.sample(uv));\nfloat gr = smoothstep(1.0 - p.y * 0.5, 1.2 - p.y * 0.5, texToFloat(d.sample(uv)));\nreturn float4(hgt, gl, gr, 1.0);",
       "y": 0.2
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat3 c0 = lerp(float3(0.7882, 0.8392, 0.8863), float3(0.9098, 0.9255, 0.9373), smoothstep(0.2, 0.7, s.x));\nc0 = lerp(c0, float3(0.6431, 0.6039, 0.5490), s.z * 0.6);\nc0 = lerp(c0, c0 * float3(0.8745, 0.9020, 0.9333), p.y * 0.4);\nreturn float4(c0, 1.0);",
       "y": 0.2
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = lerp(0.75, 0.55, p.x) - a.sample(uv).y * 0.4 - p.y * 0.2;\nreturn float4(v, v, v, 1.0);",
       "x": 0.2,
       "y": 0.2
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.2 + a.sample(uv).x * (0.6 - p.x * 0.3);\nreturn float4(v, v, v, 1.0);",
       "x": 0.2
      }
     },
     {
      "name": "VariationNoise",
      "type": "clouds",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "scale": 3,
       "octaves": 5
      }
     },
     {
      "name": "Variation",
      "type": "pixelProcessor",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nreturn float4(c.rgb * (1.0 + (texToFloat(b.sample(uv)) - 0.5) * 0.25 * p.z), c.a);",
       "z": 0.5
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "intensity": 0.8
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "radius": 0.04,
       "depth": 0.15,
       "strength": 0.6
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       1200.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       800.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1680.0,
       0.0
      ],
