     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "RippleWarp",
      "type": "perlin",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 3,
       "octaves": 4
      }
     },
     {
      "name": "Grain",
      "type": "perlin",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 200,
       "octaves": 1
      }
     },
     {
      "name": "Specks",
      "type": "cells",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 150,
       "mode": "cells",
       "jitter": 1.0
      }
     },
     {
      "name": "Scuff",
      "type": "clouds",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 5,
       "octaves": 5
      }
     },
     {
      "name": "Ripples",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float w = texToFloat(a.sample(uv));\nfloat ph = (uv.y * 14.0 + (w - 0.5) * 3.0 + sin(uv.x * 6.2832 * 2.0 + w * 3.0) * 0.4);\nfloat rip = pow(abs(sin(ph * 3.14159)), 1.5);\nfloat sc = smoothstep(0.75 - p.x * 0.3, 0.9 - p.x * 0.3, texToFloat(d.sample(uv)));\nrip = lerp(rip, 0.5, sc);\nreturn float4(rip, b.sample(uv).r, c.sample(uv), sc);",
       "x": 0.3
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat3 c0 = float3(0.7882, 0.7059, 0.5412) * (0.92 + s.x * 0.08 + (s.y - 0.5) * 0.12 * (0.5 + p.z));\nc0 = lerp(c0, float3(0.5412, 0.4627, 0.3765), step(0.975, s.z) * 0.7);\nc0 = lerp(c0, float3(0.9020, 0.8627, 0.7765), step(0.985, frac(s.z * 13.0)) * 0.6);\nc0 *= 1.0 - p.y * 0.35;\nreturn float4(c0, 1.0);",
       "z": 0.5,
       "y": 0.15
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.9 - p.y * 0.25 + (a.sample(uv).y - 0.5) * 0.06;\nreturn float4(v, v, v, 1.0);",
       "y": 0.15
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.5 + a.sample(uv).x * 0.05 + (a.sample(uv).y - 0.5) * 0.01;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 1.0
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.01,
       "depth": 0.03,
       "strength": 0.4
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1440.0,
       0.0
      ],
      "values": {}
     }
    ],
