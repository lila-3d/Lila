  "subgroups": {
   "Sand": {
    "name": "Sand",
    "typeVersion": 1,
    "description": "Fine dry sand with wind ripples, scattered darker grains and the odd shell fleck.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "RippleWarp.seed",
       "Grain.seed",
       "Specks.seed",
       "Scuff.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.3,
      "label": "Wear",
      "description": "Scuffed, footprinted ripples.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Ripples.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.15,
      "label": "Age",
      "description": "Damp, darker sand.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.y",
       "Roughness.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
