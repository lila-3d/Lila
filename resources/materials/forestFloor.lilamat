  ],
  "author": "Lila",
  "licence": "CC0-1.0",
  "version": "1.0",
  "description": "Leaf litter over dark humus: fallen leaves in browns and ochres, twigs, needles and moss."
 },
 "graph": {
  "name": "ForestFloor",
  "typeVersion": 1,
  "description": "Leaf litter over dark humus: fallen leaves in browns and ochres, twigs, needles and moss.",
  "inputs": [
   {
    "name": "seed",
    "kind": "param",
    "type": "seed",
    "default": 0,
    "label": "Seed",
    "description": "Changes the pattern without changing the look.",
    "targets": [
     "Material.seed"
    ]
   },
   {
    "name": "wear",
    "kind": "param",
    "type": "float",
    "default": 0.2,
    "label": "Wear",
    "description": "Trodden, broken-down litter.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
     "Material.wear"
    ]
   },
   {
    "name": "age",
    "kind": "param",
    "type": "float",
    "default": 0.4,
    "label": "Age",
    "description": "Decay: darker, wetter leaves and more moss.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
