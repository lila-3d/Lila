      "height"
     ],
     [
      "BaseColor",
      "out",
      "BaseColorLinear",
      "a"
     ],
     [
      "Roughness",
      "out",
      "RoughnessClamp",
      "a"
     ],
     [
      "BaseColorLinear",
      "out",
      "GroupOutput",
      "baseColor"
     ],
     [
      "RoughnessClamp",
      "out",
      "GroupOutput",
      "roughness"
     ],
     [
      "Metallic",
      "out",
      "GroupOutput",
      "metallic"
     ],
     [
      "Height",
      "out",
      "GroupOutput",
      "height"
     ],
     [
      "Normal",
      "normal",
      "GroupOutput",
      "normal"
     ],
     [
      "Occlusion",
      "out",
      "GroupOutput",
      "ao"
     ]
    ]
   }
  }
 },
