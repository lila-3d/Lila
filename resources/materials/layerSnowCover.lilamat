  "subgroups": {
   "LayerSnowCover": {
    "name": "LayerSnowCover",
    "typeVersion": 1,
    "description": "A dusting to a blanket of snow as a layer: bright soft snow with glints, piling higher where it settles.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Drifts.seed",
       "Glints.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.2,
      "label": "Wear",
      "description": "Trodden, compacted snow.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Roughness.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.3,
      "label": "Age",
      "description": "Thicker cover.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Height.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.z"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Drifts",
      "type": "clouds",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 4,
       "octaves": 6
      }
     },
     {
      "name": "Glints",
      "type": "cells",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 120,
       "mode": "cells",
       "jitter": 1.0
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float d = texToFloat(a.sample(uv));\nfloat3 c0 = lerp(float3(0.7843, 0.8314, 0.8784), float3(0.9098, 0.9255, 0.9373), smoothstep(0.2, 0.7, d) * (0.6 + p.z * 0.4));\nreturn float4(c0, 1.0);",
       "z": 0.5
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       240.0,
       160.0
      ],
      "values": {
       "expression": "float v = lerp(0.75, 0.55, p.x) - step(0.985, c.sample(uv)) * 0.4;\nreturn float4(v, v, v, 1.0);",
       "x": 0.2
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       240.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.5 + texToFloat(a.sample(uv)) * 0.08 * (0.4 + p.y);\nreturn float4(v, v, v, 1.0);",
       "y": 0.3
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "intensity": 0.6
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "radius": 0.02,
       "depth": 0.05,
       "strength": 0.4
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       480.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       960.0,
       0.0
      ],
      "values": {}
     }
    ],
    "links": [
     [
      "Drifts",
      "out",
      "BaseColor",
      "a"
     ],
     [
      "Glints",
      "out",
      "Roughness",
