  "subgroups": {
   "WoodPainted": {
    "name": "WoodPainted",
    "typeVersion": 1,
    "description": "Painted clapboard: a matte coat that follows the grain and wears through to bare wood on the edges and high spots.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Boards.seed",
       "GrainWarp.seed",
       "GrainFibre.seed",
       "Chips.seed",
       "Grime.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.35,
      "label": "Wear",
      "description": "Paint worn through to wood.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Paint.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.25,
      "label": "Age",
      "description": "Grime and fading.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Paint.y",
       "BaseColor.w"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "WoodColor.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     },
     {
      "name": "paintColor",
      "kind": "param",
      "type": "color",
      "default": [
       0.3467,
       0.45079,
       0.38133,
       1.0
      ],
      "label": "Paint Colour",
      "description": "The paint's colour (sRGB).",
      "targets": [
       "PaintColor.color"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Boards",
      "type": "planks",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "rows": 6,
       "planks": 1,
       "gap": 0.03,
       "bevel": 0.12
      }
     },
     {
      "name": "GrainWarp",
      "type": "perlin",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 5,
       "octaves": 5,
       "persistence": 0.5
      }
     },
     {
      "name": "GrainFibre",
      "type": "anisotropic",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scaleX": 4,
       "scaleY": 200,
       "octaves": 4,
       "persistence": 0.65
      }
     },
     {
      "name": "Grain",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float2 q = a.sample(uv).xy;\nfloat r = texToFloat(b.sample(uv));\nfloat w = c.sample(uv);\nfloat fb = d.sample(uv);\nfloat Y = q.y * 25.0000;\nfloat X = q.x * 150.0000;\nfloat y0 = frac(r * 7.13) * 25.0000 * 1.4 - 25.0000 * 0.2;\nfloat dep = 2.0 + frac(r * 3.71) * 14.0;\nfloat taper = (0.04 + frac(r * 5.3) * 0.08) * (frac(r * 9.1) > 0.5 ? 1.0 : -1.0);\nfloat rad = sqrt((Y - y0) * (Y - y0) + dep * dep) + X * taper + (w - 0.5) * 1.6 + sin(X * 0.08 + r * 20.0) * 0.4;\nfloat spacing = 0.5000 * (0.75 + frac(r * 2.9) * 0.5) * (1.0 + (w - 0.5) * 0.3);\nfloat t = frac(rad / spacing);\nfloat late = smoothstep(0.45, 0.8, t) * (1.0 - smoothstep(0.88, 1.0, t));\nreturn float4(t, late, fb, r);"
      }
     },
     {
      "name": "Chips",
      "type": "perlin",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 7,
       "octaves": 7,
       "persistence": 0.62
      }
     },
     {
      "name": "Grime",
      "type": "dirt",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "scale": 5,
       "amount": 0.5,
       "contrast": 1.0,
       "grain": 0.4
      }
     },
     {
      "name": "Paint",
      "type": "pixelProcessor",
      "position": [
       240.0,
       160.0
      ],
      "values": {
       "expression": "float mask = texToFloat(a.sample(uv));\nfloat n = texToFloat(b.sample(uv)) + (1.0 - mask) * 0.25;\nfloat t = 0.82 - p.x * 0.45;\nfloat chip = smoothstep(t, t + 0.02, n);\nfloat g = texToFloat(d.sample(uv));\nfloat grime = saturate((1.0 - smoothstep(0.0, 0.6, mask)) * (0.3 + p.y) + smoothstep(1.0 - p.y * 0.6, 1.3 - p.y * 0.6, g) * 0.5);\nreturn float4(mask, chip, grime, 1.0);",
       "x": 0.35,
       "y": 0.25
      }
     },
     {
      "name": "PaintColor",
      "type": "color",
      "position": [
       0.0,
       800.0
      ],
      "values": {
       "color": [
        0.3467,
        0.45079,
        0.38133,
        1.0
       ]
      }
     },
     {
      "name": "PaintColorSrgb",
      "type": "pixelProcessor",
      "position": [
       240.0,
       320.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 l = saturate(c.rgb);\nreturn float4(lerp(1.055 * pow(l, 1.0 / 2.4) - 0.055, l * 12.92, step(l, 0.0031308)), c.a);"
      }
     },
     {
      "name": "WoodColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 g = a.sample(uv);\nfloat tone = (g.w - 0.5) * 0.35 * (0.3 + p.z);\nfloat3 e = float3(0.6588, 0.5137, 0.3529) * (1.0 + tone) * (1.0 + (g.z - 0.5) * 0.18);\nfloat3 l = float3(0.4784, 0.3373, 0.2039) * (1.0 + tone * 0.8);\nfloat3 c0 = lerp(e, l, g.y);\n\nreturn float4(saturate(c0), 1.0);",
       "z": 0.5
      }
     },
     {
      "name": "ChipMask",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = b.sample(uv).y;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "GrimeMask",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = b.sample(uv).z;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "expression": "float3 wd = a.sample(uv).rgb;\nfloat3 pc = b.sample(uv).rgb;\npc = lerp(pc, dot(pc, float3(0.3, 0.4, 0.3)).xxx * 1.05, p.w * 0.25);\nfloat3 c0 = lerp(pc * (0.97 + dot(wd, float3(0.1, 0.1, 0.1))), wd, c.sample(uv));\nc0 = lerp(c0, c0 * 0.6, d.sample(uv) * 0.6);\nreturn float4(c0, 1.0);",
       "w": 0.25
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       480.0
      ],
      "values": {
       "expression": "float v = lerp(0.62, lerp(0.6, 0.75, a.sample(uv).z), b.sample(uv).y) + b.sample(uv).z * 0.15;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       640.0
      ],
      "values": {
       "expression": "float v = 0.35 + b.sample(uv).x * 0.15 + a.sample(uv).y * 0.012 + (1.0 - b.sample(uv).y) * 0.012;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "intensity": 0.8
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "radius": 0.02,
       "depth": 0.08,
       "strength": 0.8
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       1200.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       960.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1680.0,
       0.0
      ],
      "values": {}
     }
    ],
