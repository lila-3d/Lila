  "author": "Lila",
  "licence": "CC0-1.0",
  "version": "1.0",
  "description": "Painted clapboard: a matte coat that follows the grain and wears through to bare wood on the edges and high spots."
 },
 "graph": {
  "name": "WoodPainted",
  "typeVersion": 1,
  "description": "Painted clapboard: a matte coat that follows the grain and wears through to bare wood on the edges and high spots.",
  "inputs": [
