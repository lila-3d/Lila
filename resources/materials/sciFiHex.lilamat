{
 "format": "lilamat",
 "version": 1,
 "name": "SciFiHex",
 "meta": {
  "name": "Hex Plating",
  "category": "Sci-Fi/Panels",
  "tags": [
   "sci-fi",
   "scifi",
   "hex",
   "hexagon",
   "armour",
   "plating"
  ],
  "physical": "metal",
  "scaleCm": 80,
