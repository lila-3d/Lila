   "paintColor"
  ],
  "author": "Lila",
  "licence": "CC0-1.0",
  "version": "1.0",
  "description": "Armoured hexagonal plating: bevelled hex tiles in two finishes, dark seams and worn edges."
 },
 "graph": {
  "name": "SciFiHex",
  "typeVersion": 1,
  "description": "Armoured hexagonal plating: bevelled hex tiles in two finishes, dark seams and worn edges.",
  "inputs": [
   {
    "name": "seed",
    "kind": "param",
    "type": "seed",
    "default": 0,
    "label": "Seed",
    "description": "Changes the pattern without changing the look.",
    "targets": [
     "Material.seed"
    ]
   },
   {
    "name": "wear",
    "kind": "param",
    "type": "float",
    "default": 0.3,
    "label": "Wear",
    "description": "Paint chipped off the hex edges.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
     "Material.wear"
    ]
   },
   {
    "name": "age",
    "kind": "param",
    "type": "float",
    "default": 0.2,
    "label": "Age",
    "description": "Grime in the seams.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
     "Material.age"
    ]
   },
   {
    "name": "colorVariation",
    "kind": "param",
    "type": "float",
    "default": 0.5,
    "label": "Colour Variation",
    "description": "How much the colour wanders across the surface.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
     "Material.colorVariation"
    ]
   },
   {
    "name": "hue",
    "kind": "param",
    "type": "float",
    "default": 0.0,
    "label": "Hue",
    "description": "Shifts the base colour's hue, in turns.",
    "min": -0.5,
    "max": 0.5,
    "targets": [
     "Material.hue"
    ]
   },
   {
    "name": "paintColor",
    "kind": "param",
    "type": "color",
    "default": [
     0.07819,
     0.10224,
     0.08438,
     1.0
    ],
    "label": "Paint Colour",
    "description": "The plating paint (sRGB).",
    "targets": [
     "Material.paintColor"
    ]
   }
  ],
  "nodes": [
