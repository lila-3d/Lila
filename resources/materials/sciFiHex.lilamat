  "subgroups": {
   "SciFiHex": {
    "name": "SciFiHex",
    "typeVersion": 1,
    "description": "Armoured hexagonal plating: bevelled hex tiles in two finishes, dark seams and worn edges.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Hexes.seed",
       "ChipNoise.seed",
       "Grime.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.3,
      "label": "Wear",
      "description": "Paint chipped off the hex edges.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Wear.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.2,
      "label": "Age",
      "description": "Grime in the seams.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Wear.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "PanelTone.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     },
     {
      "name": "paintColor",
      "kind": "param",
      "type": "color",
      "default": [
       0.07819,
       0.10224,
       0.08438,
       1.0
      ],
      "label": "Paint Colour",
      "description": "The plating paint (sRGB).",
      "targets": [
       "PaintColor.color"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Hexes",
      "type": "hex",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 10,
       "gap": 0.05,
       "bevel": 0.12
      }
     },
     {
      "name": "Hex",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float mask = texToFloat(a.sample(uv));\nfloat r = c.sample(uv);\nfloat hgt = 0.2 + mask * 0.5 + (r - 0.5) * 0.03 * mask;\nfloat seam = 1.0 - smoothstep(0.0, 0.2, mask);\nfloat edge = (1.0 - smoothstep(0.6, 0.95, mask)) * step(0.05, mask);\nreturn float4(hgt, seam, edge, r);"
      }
     },
     {
      "name": "ChipNoise",
      "type": "perlin",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 24,
       "octaves": 5,
       "persistence": 0.6
      }
     },
     {
      "name": "Grime",
      "type": "dirt",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 5,
       "amount": 0.5,
       "contrast": 1.0,
       "grain": 0.4
      }
     },
     {
      "name": "Wear",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat ch = smoothstep(1.0 - p.x * 0.9, 1.05 - p.x * 0.9, s.z * 0.9 + texToFloat(b.sample(uv)) * 0.4);\nfloat g = smoothstep(1.0 - p.y * 0.8, 1.2 - p.y * 0.8, texToFloat(c.sample(uv)) * 0.6 + s.y * 0.6);\nreturn float4(ch, g, 0.0, 1.0);",
       "x": 0.3,
       "y": 0.2
      }
     },
     {
      "name": "PaintColor",
      "type": "color",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "color": [
        0.07819,
        0.10224,
        0.08438,
        1.0
       ]
      }
     },
     {
      "name": "PaintColorSrgb",
      "type": "pixelProcessor",
      "position": [
       240.0,
       160.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 l = saturate(c.rgb);\nreturn float4(lerp(1.055 * pow(l, 1.0 / 2.4) - 0.055, l * 12.92, step(l, 0.0031308)), c.a);"
      }
     },
     {
      "name": "PanelTone",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nreturn float4(b.sample(uv).rgb * (1.0 + (s.w - 0.5) * 0.12 * (0.3 + p.z)), s.y);",
       "z": 0.5
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "expression": "float4 pc = a.sample(uv);\nfloat4 w = b.sample(uv);\nfloat3 c0 = lerp(pc.rgb, float3(0.9020, 0.9059, 0.9098), w.x);\nc0 = lerp(c0, float3(0.2275, 0.2118, 0.1961), w.y * 0.7);\nc0 = lerp(c0, c0 * 0.4, pc.a);\nreturn float4(c0, 1.0);"
      }
     },
     {
      "name": "MetalMask",
      "type": "pixelProcessor",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "expression": "float v = b.sample(uv).x * (1.0 - b.sample(uv).y);\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "expression": "float v = lerp(0.38 + (a.sample(uv).w - 0.5) * 0.08, 0.3, b.sample(uv).x) + b.sample(uv).y * 0.4 + a.sample(uv).y * 0.3;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = 0.3 + a.sample(uv).x * 0.4 - b.sample(uv).x * 0.004;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "intensity": 1.0
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       960.0,
       160.0
      ],
      "values": {
       "radius": 0.01,
       "depth": 0.1,
       "strength": 0.9
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       960.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       1200.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       960.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1680.0,
       0.0
      ],
      "values": {}
     }
    ],
    "links": [
