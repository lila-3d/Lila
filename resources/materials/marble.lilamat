    "nodes": [
     {
      "name": "VeinNoise",
      "type": "perlin",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 2,
       "octaves": 4,
       "persistence": 0.45
      }
     },
     {
      "name": "WarpNoise",
      "type": "perlin",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 3,
       "octaves": 6,
       "persistence": 0.55
      }
     },
     {
      "name": "FineVeins",
      "type": "perlin",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 4,
       "octaves": 4,
       "persistence": 0.5
      }
     },
     {
      "name": "Clouding",
      "type": "clouds",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 4,
       "octaves": 6
      }
     },
     {
      "name": "Veins",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float2 o = float2(texToFloat(b.sample(uv)), texToFloat(b.sample(uv + float2(0.31, 0.57)))) - 0.5;\nfloat v1 = texToFloat(a.sample(uv + o * 0.45));\nfloat v2 = c.sample(uv + o * 0.3);\nfloat cl = d.sample(uv);\nfloat main = 1.0 - smoothstep(0.0, 0.006 + cl * 0.01, abs(v1 - 0.5));\nfloat halo = 1.0 - smoothstep(0.0, 0.05, abs(v1 - 0.5));\nfloat fine = (1.0 - smoothstep(0.0, 0.004, abs(v2 - 0.53))) * smoothstep(0.25, 0.5, cl) * 0.8;\nreturn float4(main, halo, fine, cl);"
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 v = a.sample(uv);\nfloat3 c0 = lerp(float3(0.9137, 0.9059, 0.8863), float3(0.8157, 0.8118, 0.7961), saturate((v.w - 0.35) * 1.4 * (0.4 + p.z)));\nc0 = lerp(c0, float3(0.7255, 0.7255, 0.7176), v.y * 0.5);\nc0 = lerp(c0, float3(0.4353, 0.4471, 0.4784), v.x * 0.85);\nc0 = lerp(c0, float3(0.5569, 0.5647, 0.5882), v.z * 0.7);\nc0 = lerp(c0, c0 * float3(0.9490, 0.9020, 0.8000), p.y * 0.6);\nreturn float4(c0, 1.0);",
       "z": 0.5,
       "y": 0.1
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.08 + a.sample(uv).x * 0.05 + p.x * 0.35 * (0.5 + a.sample(uv).w);\nreturn float4(v, v, v, 1.0);",
       "x": 0.15
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.5 - a.sample(uv).x * 0.002;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 0.3
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.01,
       "depth": 0.02,
       "strength": 0.2
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1440.0,
       0.0
      ],
      "values": {}
     }
    ],
