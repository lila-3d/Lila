    "name": "LayerBurn",
    "typeVersion": 1,
    "description": "Char and soot as a layer: crazed black char at the centre, sooty smudge at the edges, a few glowing-hot embers' worth of brown.",
    "inputs": [
     {
      "name": "seed",
