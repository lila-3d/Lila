     }
    ],
    "nodes": [
     {
      "name": "Craze",
      "type": "cells",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 14,
       "mode": "crackle",
       "width": 0.02,
       "jitter": 1.0
      }
     },
     {
      "name": "Soot",
      "type": "clouds",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 4,
       "octaves": 6
      }
     },
     {
      "name": "Char",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float cz = texToFloat(a.sample(uv)) * p.x;\nfloat st = texToFloat(b.sample(uv));\nreturn float4(cz, st, 0.0, 1.0);",
       "x": 0.4
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat3 c0 = lerp(float3(0.1647, 0.1490, 0.1412), float3(0.2902, 0.2431, 0.2039), saturate(s.y * 0.6 * (0.5 + p.z)));\nc0 = lerp(c0, float3(0.4314, 0.4157, 0.4000), p.y * smoothstep(0.4, 0.8, s.y) * 0.6);\nc0 = lerp(c0, float3(0.1216, 0.1137, 0.1098), s.x);\nreturn float4(c0, 1.0);",
       "y": 0.3,
       "z": 0.5
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.9 - a.sample(uv).x * 0.2;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.5 - a.sample(uv).x * 0.04 + (a.sample(uv).y - 0.5) * 0.01;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 0.8
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.01,
       "depth": 0.03,
       "strength": 0.5
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1200.0,
       0.0
      ],
