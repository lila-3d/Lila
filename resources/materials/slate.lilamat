     }
    ],
    "nodes": [
     {
      "name": "Cleft",
      "type": "crystal",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 4,
       "octaves": 3,
       "persistence": 0.45
      }
     },
     {
      "name": "Grain",
      "type": "directional",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "angle": 20.0,
       "scaleAlong": 2,
       "scaleAcross": 30,
       "octaves": 4
      }
     },
     {
      "name": "Stain",
      "type": "clouds",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 3,
       "octaves": 6
      }
     },
     {
      "name": "Layers",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float k = texToFloat(a.sample(uv));\nfloat steps = floor(k * 6.0) / 6.0;\nfloat edge = smoothstep(0.0, 0.05, frac(k * 6.0));\nreturn float4(steps, edge, texToFloat(b.sample(uv)), c.sample(uv));"
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat3 c0 = lerp(float3(0.2314, 0.2510, 0.2824), float3(0.3294, 0.3529, 0.3882), saturate(s.x * 0.8 + (s.z - 0.5) * 0.3));\nc0 = lerp(c0, float3(0.4157, 0.3804, 0.3451), smoothstep(0.55, 0.8, s.w) * p.y * (0.5 + p.z));\nc0 = lerp(c0 * 1.2, c0, s.y);\nreturn float4(c0, 1.0);",
       "z": 0.5,
       "y": 0.2
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.6 + (a.sample(uv).z - 0.5) * 0.15 + (1.0 - a.sample(uv).y) * 0.15;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.4 + a.sample(uv).x * 0.15 + (a.sample(uv).z - 0.5) * 0.01;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "WornRelief",
      "type": "pixelProcessor",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "expression": "float v = 0.5 + (texToFloat(a.sample(uv)) - 0.5) * (1.0 - p.x * 0.6);\nreturn float4(v, v, v, 1.0);",
       "x": 0.3
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "intensity": 1.2
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       960.0,
       160.0
      ],
      "values": {
       "radius": 0.02,
       "depth": 0.06,
       "strength": 0.6
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       960.0,
       320.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1440.0,
       0.0
      ],
