      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Bond",
      "type": "bricks",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "rows": 13,
       "columns": 4,
       "offset": 0.5,
       "mortar": 0.09,
       "bevel": 0.06
      }
     },
     {
      "name": "Chip",
      "type": "perlin",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 40,
       "octaves": 4,
       "persistence": 0.6
      }
     },
     {
      "name": "Sand",
      "type": "perlin",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 128,
       "octaves": 2
      }
     },
     {
      "name": "Faces",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float mask = texToFloat(a.sample(uv));\nfloat ch = texToFloat(b.sample(uv));\nfloat face = smoothstep(0.0, 0.6, mask - (ch - 0.5) * (0.5 + p.x * 1.2) * (1.0 - mask));\nreturn float4(face, mask, c.sample(uv), d.sample(uv));",
       "x": 0.3
      }
     },
     {
      "name": "Grime",
      "type": "dirt",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 4,
       "amount": 0.5,
       "contrast": 1.0,
       "grain": 0.4
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat r = s.z;\nfloat3 br = lerp(float3(0.5490, 0.2471, 0.1725), float3(0.6588, 0.3529, 0.2431), frac(r * 3.3));\nbr = lerp(br, float3(0.4314, 0.2000, 0.1490), step(0.82, frac(r * 5.7)) * 0.8);\nbr = lerp(br, float3(0.7059, 0.4706, 0.3529), step(0.88, frac(r * 9.1)) * 0.6);\nbr = lerp(lerp(float3(0.6039, 0.2902, 0.2039), float3(0.6039, 0.2902, 0.2039), 0.5), br, 0.4 + p.z * 0.6);\nbr *= 0.88 + s.w * 0.2;\nfloat3 mo = float3(0.7059, 0.6745, 0.6196) * (0.9 + s.w * 0.15);\nfloat3 c0 = lerp(mo, br, s.x);\nfloat g = texToFloat(b.sample(uv));\nc0 = lerp(c0, c0 * 0.55, smoothstep(1.0 - p.y * 0.6, 1.2 - p.y * 0.6, g) * 0.8);\nfloat eff = smoothstep(0.7, 0.9, g * (1.0 - s.x * 0.5)) * p.y;\nc0 = lerp(c0, float3(0.8471, 0.8314, 0.8000), eff * 0.5);\nreturn float4(c0, 1.0);",
       "z": 0.5,
       "y": 0.25
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = lerp(0.92, 0.8, a.sample(uv).x) + (a.sample(uv).w - 0.5) * 0.08;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.3 + a.sample(uv).x * 0.25 + (a.sample(uv).w - 0.5) * 0.02 + (c.sample(uv) - 0.5) * 0.02 * a.sample(uv).x;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 1.0
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.02,
       "depth": 0.1,
       "strength": 0.9
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1440.0,
       0.0
      ],
      "values": {}
     }
    ],
