      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Drop",
      "type": "shape",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "shape": "circle",
       "size": 0.7,
       "softness": 2.0
      }
     },
     {
      "name": "Drops",
      "type": "splatter",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "countX": 8,
       "countY": 8,
       "perCell": 3,
       "size": 0.35,
       "sizeRandom": 0.8,
       "valueRandom": 0.2,
       "blend": "max"
      }
     },
     {
      "name": "Smear",
      "type": "directional",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "angle": 20.0,
       "scaleAlong": 2,
       "scaleAcross": 16,
       "octaves": 5
      }
     },
     {
      "name": "Pool",
      "type": "clouds",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 4,
       "octaves": 6
      }
     },
     {
      "name": "DryCracks",
      "type": "cells",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 18,
       "mode": "crackle",
       "width": 0.01,
       "jitter": 1.0
      }
     },
     {
      "name": "Blood",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float dr = c.sample(uv);\nfloat sm = smoothstep(0.62 - p.x * 0.2, 0.75 - p.x * 0.2, texToFloat(a.sample(uv))) * p.x;\nfloat pl = texToFloat(b.sample(uv));\nfloat thick = saturate(max(dr, sm * 0.6) + smoothstep(0.55, 0.8, pl) * 0.5);\nreturn float4(thick, pl, d.sample(uv) * smoothstep(0.4, 0.9, p.y), 1.0);",
       "x": 0.3,
       "y": 0.3
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat3 fresh = lerp(float3(0.4784, 0.0627, 0.0627), float3(0.3059, 0.0392, 0.0392), saturate(s.x * 0.8 + (s.y - 0.5) * 0.4 * (0.5 + p.z)));\nfloat3 dried = lerp(float3(0.3529, 0.1647, 0.1176), float3(0.2510, 0.1255, 0.1020), s.x);\nfloat3 c0 = lerp(fresh, dried, p.y);\nc0 = lerp(c0, float3(0.2275, 0.1098, 0.0863), s.z * 0.6);\nreturn float4(c0, 1.0);",
       "y": 0.3,
       "z": 0.5
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "expression": "float v = lerp(0.12, 0.6, p.y) + a.sample(uv).z * 0.2;\nreturn float4(v, v, v, 1.0);",
       "y": 0.3
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.5 + a.sample(uv).x * 0.03 * (1.0 - p.y * 0.5);\nreturn float4(v, v, v, 1.0);",
       "y": 0.3
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "intensity": 0.6
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       960.0,
       160.0
      ],
      "values": {
       "radius": 0.005,
       "depth": 0.01,
       "strength": 0.2
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       960.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       1200.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       960.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1680.0,
       0.0
      ],
      "values": {}
     }
