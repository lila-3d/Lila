  "subgroups": {
   "LayerBlood": {
    "name": "LayerBlood",
    "typeVersion": 1,
    "description": "Blood as a layer: glossy dark red drops, splashes and smears, browning and dulling as it dries.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Drops.seed",
       "Smear.seed",
       "Pool.seed",
       "DryCracks.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.3,
      "label": "Wear",
      "description": "Smeared, wiped streaks.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Blood.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.3,
      "label": "Age",
      "description": "Drying: browner, duller, cracked.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Blood.y",
       "BaseColor.y",
       "Roughness.y",
       "Height.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
