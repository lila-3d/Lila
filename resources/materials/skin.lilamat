      "default": 0.2,
      "label": "Wear",
      "description": "Deeper wrinkles.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Detail.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.2,
      "label": "Age",
      "description": "Freckles and blotches.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
