    "nodes": [
     {
      "name": "Pores",
      "type": "worley",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 72,
       "octaves": 1
      }
     },
     {
      "name": "Wrinkles",
      "type": "directional",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "angle": 30.0,
       "scaleAlong": 3,
       "scaleAcross": 64,
       "octaves": 3
      }
     },
     {
      "name": "Wrinkles2",
      "type": "directional",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "angle": 150.0,
       "scaleAlong": 3,
       "scaleAcross": 56,
       "octaves": 3
      }
     },
     {
      "name": "Redness",
      "type": "clouds",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 4,
       "octaves": 6
      }
     },
     {
      "name": "Detail",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float po = 1.0 - smoothstep(0.0, 0.18, a.sample(uv).r);\nfloat k1 = 1.0 - smoothstep(0.0, 0.03, abs(texToFloat(b.sample(uv)) - 0.5));\nfloat k2 = 1.0 - smoothstep(0.0, 0.03, abs(c.sample(uv) - 0.5));\nfloat wr = max(k1, k2 * 0.7) * (0.4 + p.x);\nreturn float4(po, wr, d.sample(uv), 1.0);",
       "x": 0.2
      }
     },
     {
      "name": "Freckles",
      "type": "worley",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "scale": 60,
       "octaves": 1,
       "invert": true
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat3 c0 = lerp(float3(0.7882, 0.6039, 0.5020), float3(0.8392, 0.6667, 0.5647), s.z * (0.4 + p.z * 0.6));\nc0 = lerp(c0, float3(0.7686, 0.4941, 0.4235), smoothstep(0.55, 0.85, s.z) * 0.35);\nc0 *= 1.0 - s.x * 0.06 - s.y * 0.05;\nc0 = lerp(c0, float3(0.6902, 0.4784, 0.3843), smoothstep(1.0 - p.y * 0.2, 1.05 - p.y * 0.2, texToFloat(b.sample(uv))) * 0.45);\nreturn float4(c0, 1.0);",
       "z": 0.5,
       "y": 0.2
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.48 + a.sample(uv).x * 0.15 + a.sample(uv).y * 0.08 + (a.sample(uv).z - 0.5) * 0.06;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.5 - a.sample(uv).x * 0.006 - a.sample(uv).y * 0.006;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 0.6
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.003,
       "depth": 0.01,
       "strength": 0.3
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       800.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1440.0,
       0.0
      ],
      "values": {}
     }
    ],
