   "Skin": {
    "name": "Skin",
    "typeVersion": 1,
    "description": "A neutral skin base: pores, fine crossing wrinkles, subtle redness and tone variation. Hue shifts the tone.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Pores.seed",
       "Wrinkles.seed",
       "Wrinkles2.seed",
       "Redness.seed",
       "Freckles.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
