     }
    ],
    "nodes": [
     {
      "name": "Cushions",
      "type": "worley",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 10,
       "octaves": 3,
       "persistence": 0.5,
       "invert": true
      }
     },
     {
      "name": "Fuzz",
      "type": "perlin",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 120,
       "octaves": 2
      }
     },
     {
      "name": "Tone",
      "type": "clouds",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 4,
       "octaves": 5
      }
     },
     {
      "name": "Moss",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float cu = texToFloat(a.sample(uv));\nfloat fz = c.sample(uv);\nfloat hgt = cu * 0.8 + fz * 0.2;\nreturn float4(hgt, fz, d.sample(uv), 1.0);"
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat3 c0 = lerp(float3(0.2353, 0.3294, 0.1255), float3(0.4784, 0.6039, 0.2039), saturate(s.x * 0.8 + (s.z - 0.5) * 0.6 * (0.4 + p.z)));\nc0 = lerp(c0, float3(0.1804, 0.2431, 0.1020), p.y * 0.3 * (1.0 - s.x));\nc0 = lerp(c0, float3(0.4784, 0.4314, 0.2431), smoothstep(0.6, 0.9, s.z) * p.x);\nc0 *= 0.8 + s.y * 0.3;\nreturn float4(c0, 1.0);",
       "z": 0.5,
       "y": 0.4,
       "x": 0.2
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.9 + (a.sample(uv).y - 0.5) * 0.1;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.5 + a.sample(uv).x * 0.15 * (0.5 + p.y);\nreturn float4(v, v, v, 1.0);",
       "y": 0.4
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 1.0
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.01,
       "depth": 0.06,
       "strength": 0.8
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1440.0,
       0.0
      ],
