   "LayerMoss": {
    "name": "LayerMoss",
    "typeVersion": 1,
    "description": "Moss as a layer: soft cushions of bright and olive green with fuzzy height, for growth on stone, wood and roofs.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Cushions.seed",
       "Fuzz.seed",
       "Tone.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.2,
      "label": "Wear",
      "description": "Trampled, browned moss.",
      "min": 0.0,
