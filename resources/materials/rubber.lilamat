    "nodes": [
     {
      "name": "Mottle",
      "type": "clouds",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 5,
       "octaves": 6
      }
     },
     {
      "name": "Grain",
      "type": "perlin",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 96,
       "octaves": 2
      }
     },
     {
      "name": "Grime",
      "type": "dirt",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 5,
       "amount": 0.5,
       "contrast": 1.0,
       "grain": 0.4
      }
     },
     {
      "name": "Scuffs",
      "type": "scratches",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 6,
       "count": 5,
       "length": 0.4,
       "width": 0.0012,
       "angleRandom": 1.0
      }
     },
     {
      "name": "DustScuffs",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float d0 = smoothstep(1.0 - p.y * 0.6, 1.25 - p.y * 0.6, texToFloat(a.sample(uv)));\nfloat s = c.sample(uv) * smoothstep(0.0, 0.6, p.x);\nreturn float4(d0, s, 0.0, 1.0);",
       "x": 0.2,
       "y": 0.2
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 d = b.sample(uv);\nfloat3 c0 = float3(0.1725, 0.1725, 0.1725) * (0.92 + texToFloat(a.sample(uv)) * 0.14 * (0.5 + p.z));\nc0 = lerp(c0, float3(0.4235, 0.4118, 0.3922), d.x * 0.6);\nreturn float4(c0, 1.0);",
       "z": 0.5
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.82 + (texToFloat(a.sample(uv)) - 0.5) * 0.1 - smoothstep(0.6, 0.9, texToFloat(a.sample(uv))) * p.x * 0.4 + b.sample(uv).x * 0.1;\nreturn float4(v, v, v, 1.0);",
       "x": 0.2
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       240.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.5 + (c.sample(uv) - 0.5) * 0.004;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "intensity": 0.5
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       480.0,
       480.0
      ],
      "values": {
       "radius": 0.005,
       "depth": 0.01,
       "strength": 0.2
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "value": 0.0
      }
     },
