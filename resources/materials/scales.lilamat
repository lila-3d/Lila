     }
    ],
    "nodes": [
     {
      "name": "Scales",
      "type": "scales",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 12,
       "size": 1.25
      }
     },
     {
      "name": "Pattern",
      "type": "clouds",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 3,
       "octaves": 5
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float hgt = texToFloat(a.sample(uv));\nfloat r = texToFloat(b.sample(uv));\nfloat pat = c.sample(uv);\nfloat3 c0 = lerp(float3(0.2431, 0.3529, 0.1804), float3(0.4314, 0.5412, 0.2353), saturate(r * 0.6 * (0.4 + p.z) + pat * 0.6));\nc0 = lerp(c0, float3(0.1647, 0.2039, 0.1255), smoothstep(0.55, 0.75, pat) * 0.7);\nc0 *= 0.55 + hgt * 0.55;\nc0 = lerp(c0, float3(0.7216, 0.7059, 0.6039), step(1.0 - p.y * 0.3, frac(r * 7.0)) * 0.6);\nreturn float4(c0, 1.0);",
       "z": 0.5,
       "y": 0.2
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       240.0,
       160.0
      ],
      "values": {
       "expression": "float v = lerp(0.65, 0.35, texToFloat(a.sample(uv))) + p.x * 0.2;\nreturn float4(v, v, v, 1.0);",
       "x": 0.2
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       240.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.3 + texToFloat(a.sample(uv)) * 0.4;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "intensity": 1.0
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "radius": 0.01,
       "depth": 0.08,
       "strength": 0.8
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       480.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1200.0,
       0.0
      ],
