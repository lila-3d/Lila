      "default": 0.2,
      "label": "Age",
      "description": "Shedding: pale dry scales.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
