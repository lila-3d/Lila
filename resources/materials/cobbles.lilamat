  "subgroups": {
   "Cobbles": {
    "name": "Cobbles",
    "typeVersion": 1,
    "description": "Rounded cobbles set in sandy joints: each stone its own grey-brown, polished tops, grit and moss in the gaps.",
    "inputs": [
     {
      "name": "seed",
