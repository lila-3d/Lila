      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Stones.seed",
       "StoneId.seed",
       "Lumps.seed",
       "JointFill.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
