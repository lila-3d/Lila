    ],
    "nodes": [
     {
      "name": "Stones",
      "type": "cells",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 7,
       "mode": "f2MinusF1",
       "jitter": 0.85
      }
     },
     {
      "name": "StoneId",
      "type": "cells",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 7,
       "mode": "cells",
       "jitter": 0.85
      }
     },
     {
      "name": "Lumps",
      "type": "perlin",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 20,
       "octaves": 4
      }
     },
     {
      "name": "JointFill",
      "type": "dirt",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 12,
       "amount": 0.5,
       "contrast": 2.0,
       "grain": 0.8
      }
     },
     {
      "name": "Shape",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float e = c.sample(uv);\nfloat id = d.sample(uv);\nfloat l = texToFloat(a.sample(uv));\nfloat dome = sqrt(saturate(e / 0.32)) * (0.85 + id * 0.15) + (l - 0.5) * 0.12;\nfloat stone = smoothstep(0.02, 0.07, e + (l - 0.5) * 0.03);\nreturn float4(dome, stone, id, l);"
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat j = texToFloat(b.sample(uv));\nfloat3 st = lerp(float3(0.4314, 0.4157, 0.3922), float3(0.6039, 0.5804, 0.5451), frac(s.z * 3.1));\nst = lerp(st, float3(0.5216, 0.4588, 0.3882), step(0.7, frac(s.z * 7.3)) * (0.3 + p.z * 0.6));\nst *= 0.85 + s.w * 0.3;\nst = lerp(st, st * 1.15, smoothstep(0.7, 1.0, s.x) * p.x);\nfloat3 jc = lerp(float3(0.4157, 0.3725, 0.3137), float3(0.6118, 0.5608, 0.4706), j);\nfloat moss = smoothstep(0.3, 0.9, j) * smoothstep(0.0, 1.0, p.y);\njc = lerp(jc, float3(0.2980, 0.3529, 0.1725), moss);\nfloat3 c0 = lerp(jc, st, s.y);\nc0 = lerp(c0, c0 * 0.7, (1.0 - smoothstep(0.0, 0.25, s.x)) * s.y * 0.6);\nreturn float4(c0, 1.0);",
       "z": 0.5,
       "x": 0.4,
       "y": 0.3
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = lerp(0.92, lerp(0.75, 0.45, smoothstep(0.6, 1.0, a.sample(uv).x) * p.x), a.sample(uv).y);\nreturn float4(v, v, v, 1.0);",
       "x": 0.4
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = lerp(0.15 + texToFloat(b.sample(uv)) * 0.05, 0.25 + a.sample(uv).x * 0.6, a.sample(uv).y);\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 1.2
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.04,
       "depth": 0.25,
       "strength": 1.0
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1440.0,
       0.0
      ],
      "values": {}
     }
