      "max": 1.0,
      "targets": [
       "BaseColor.x",
       "Roughness.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.3,
      "label": "Age",
      "description": "Moss and dirt in the joints.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
