  "subgroups": {
   "SteelPainted": {
    "name": "SteelPainted",
    "typeVersion": 1,
    "description": "Industrial enamel over steel: orange-peel paint that chips at wear to bare and rusting metal.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Chips.seed",
       "ChipShape.seed",
       "OrangePeel.seed",
       "Grime.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.35,
      "label": "Wear",
      "description": "Paint chipped back to steel.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Paint.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.25,
      "label": "Age",
      "description": "Grime and rust in the chips.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Paint.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     },
     {
      "name": "paintColor",
      "kind": "param",
      "type": "color",
      "default": [
       0.04374,
       0.10946,
       0.17144,
       1.0
      ],
      "label": "Paint Colour",
      "description": "The enamel's colour (sRGB).",
      "targets": [
       "PaintColor.color"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Chips",
      "type": "perlin",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 6,
       "octaves": 7,
       "persistence": 0.62
      }
     },
     {
      "name": "ChipShape",
      "type": "cells",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 24,
       "mode": "f2MinusF1",
       "jitter": 1.0
      }
     },
     {
      "name": "OrangePeel",
      "type": "perlin",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 96,
       "octaves": 2
      }
     },
     {
      "name": "Grime",
      "type": "dirt",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 5,
       "amount": 0.5,
       "contrast": 1.0,
       "grain": 0.4
      }
     },
     {
      "name": "Paint",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float n = texToFloat(a.sample(uv)) + c.sample(uv) * 0.18;\nfloat t = 0.8 - p.x * 0.45;\nfloat chip = smoothstep(t, t + 0.015, n);\nfloat rim = smoothstep(t - 0.04, t, n) - chip;\nfloat g = texToFloat(b.sample(uv));\nfloat grime = smoothstep(1.0 - p.y * 0.6, 1.0 - p.y * 0.6 + 0.3, g);\nreturn float4(chip, saturate(rim), grime, d.sample(uv));",
       "x": 0.35,
       "y": 0.25
      }
     },
     {
      "name": "PaintColor",
      "type": "color",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "color": [
        0.04374,
        0.10946,
        0.17144,
        1.0
       ]
      }
     },
     {
      "name": "PaintColorSrgb",
      "type": "pixelProcessor",
      "position": [
       240.0,
       160.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 l = saturate(c.rgb);\nreturn float4(lerp(1.055 * pow(l, 1.0 / 2.4) - 0.055, l * 12.92, step(l, 0.0031308)), c.a);"
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat3 pc = b.sample(uv).rgb * (1.0 + (s.w - 0.5) * 0.06 * (0.5 + p.z));\npc = lerp(pc, pc * 0.8 + float3(0.2275, 0.2039, 0.1725) * 0.2, s.z * 0.6);\nfloat3 steel = lerp(float3(0.7765, 0.7843, 0.7882), float3(0.4784, 0.2902, 0.1725), saturate(s.z * 1.5 + s.y));\nfloat3 c0 = lerp(pc, steel, s.x);\nc0 = lerp(c0, pc * 1.15, s.y * 0.5);\nreturn float4(saturate(c0), 1.0);",
       "z": 0.5
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = lerp(lerp(0.32, 0.5, a.sample(uv).w) + a.sample(uv).z * 0.3, lerp(0.35, 0.8, a.sample(uv).z), a.sample(uv).x);\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "MetalMask",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = step(0.5, a.sample(uv).x) * (1.0 - smoothstep(0.45, 0.55, a.sample(uv).z));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       480.0
      ],
      "values": {
       "expression": "float v = 0.5 + (1.0 - a.sample(uv).x) * 0.04 + (a.sample(uv).w - 0.5) * 0.004;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 0.8
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.01,
       "depth": 0.04,
       "strength": 0.6
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1440.0,
       0.0
      ],
      "values": {}
     }
    ],
    "links": [
