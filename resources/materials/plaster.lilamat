  "subgroups": {
   "Plaster": {
    "name": "Plaster",
    "typeVersion": 1,
    "description": "Hand-trowelled lime plaster: soft sweeping trowel marks, chalky off-white, hairline cracks as it ages.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Trowel.seed",
       "Soft.seed",
       "Cracks.seed",
       "Chips.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.2,
      "label": "Wear",
      "description": "Chips back to the base coat.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Surface.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.3,
      "label": "Age",
      "description": "Hairline cracks and discolouration.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Surface.y",
       "BaseColor.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
