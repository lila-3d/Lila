     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Trowel",
      "type": "gabor",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 3,
       "impulses": 6,
       "frequency": 0.8,
       "angleRandom": 1.0
      }
     },
     {
      "name": "Soft",
      "type": "clouds",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 3,
       "octaves": 6
      }
     },
     {
      "name": "Cracks",
      "type": "cells",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 5,
       "mode": "crackle",
       "width": 0.012,
       "jitter": 1.0
      }
     },
     {
      "name": "CrackWarp",
      "type": "warp",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "mode": "gradient",
       "intensity": 0.6
      }
     },
     {
      "name": "Chips",
      "type": "perlin",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 10,
       "octaves": 6,
       "persistence": 0.62
      }
     },
     {
      "name": "Surface",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float tr = texToFloat(a.sample(uv));\nfloat sf = texToFloat(b.sample(uv));\nfloat ck = texToFloat(c.sample(uv)) * smoothstep(0.65 - p.y * 0.4, 0.85 - p.y * 0.4, sf);\nfloat chip = smoothstep(0.82 - p.x * 0.25, 0.84 - p.x * 0.25, d.sample(uv));\nreturn float4(tr, sf, ck, chip);",
       "x": 0.2,
       "y": 0.3
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat3 c0 = float3(0.8510, 0.8235, 0.7686) * (0.97 + (s.y - 0.5) * 0.12 * (0.4 + p.z) + (s.x - 0.5) * 0.05);\nc0 = lerp(c0, c0 * float3(0.9098, 0.8627, 0.7529), smoothstep(0.5, 0.9, s.y) * p.y);\nc0 = lerp(c0, float3(0.6039, 0.5608, 0.5020), s.w * 0.8);\nc0 = lerp(c0, c0 * 0.72, s.z);\nreturn float4(c0, 1.0);",
       "z": 0.5,
       "y": 0.3
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.82 + (a.sample(uv).x - 0.5) * 0.12;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.5 + (a.sample(uv).x - 0.5) * 0.04 + (a.sample(uv).y - 0.5) * 0.03 - a.sample(uv).z * 0.04 - a.sample(uv).w * 0.08;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "intensity": 0.8
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       960.0,
       160.0
      ],
      "values": {
       "radius": 0.01,
       "depth": 0.04,
       "strength": 0.5
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       960.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       1200.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       960.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1680.0,
       0.0
      ],
