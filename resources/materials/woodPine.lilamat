  "subgroups": {
   "WoodPine": {
    "name": "WoodPine",
    "typeVersion": 1,
    "description": "Pale knotty-free pine boards with strong summer/winter ring contrast.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Boards.seed",
       "GrainWarp.seed",
       "GrainFibre.seed",
       "Dents.seed",
       "Grime.seed"
      ]
     },
     {
      "name": "wear",
