  "subgroups": {
   "Sandstone": {
    "name": "Sandstone",
    "typeVersion": 1,
    "description": "Bedded sandstone: warm sandy layers, the soft ones weathered back, gritty grain and pitting.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Beds.seed",
       "BedWarp.seed",
       "Grit.seed",
       "Pits.seed",
       "Grime.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.4,
      "label": "Wear",
      "description": "Erosion of the soft beds.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Height.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.25,
      "label": "Age",
      "description": "Dark weathering crust and lichen.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
