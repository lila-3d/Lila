     }
    ],
    "nodes": [
     {
      "name": "Beds",
      "type": "directional",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "angle": 0.0,
       "scaleAlong": 2,
       "scaleAcross": 10,
       "octaves": 6,
       "persistence": 0.6
      }
     },
     {
      "name": "BedWarp",
      "type": "perlin",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 3,
       "octaves": 4
      }
     },
     {
      "name": "BedsWarped",
      "type": "warp",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "mode": "gradient",
       "intensity": 2.0
      }
     },
     {
      "name": "Grit",
      "type": "perlin",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 96,
       "octaves": 2
      }
     },
     {
      "name": "Pits",
      "type": "worley",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 18,
       "octaves": 2,
       "invert": false
      }
     },
     {
      "name": "Bedding",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float b0 = texToFloat(a.sample(uv));\nfloat soft = smoothstep(0.35, 0.65, b0);\nfloat pit = smoothstep(0.12, 0.0, d.sample(uv)) * 0.7;\nreturn float4(b0, soft, c.sample(uv), pit);"
      }
     },
     {
      "name": "Grime",
      "type": "dirt",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "scale": 3,
       "amount": 0.5,
       "contrast": 1.0,
       "grain": 0.4
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat3 c0 = lerp(float3(0.7216, 0.5529, 0.3686), float3(0.8392, 0.7333, 0.5725), s.x);\nc0 = lerp(c0, float3(0.6588, 0.4431, 0.3059), smoothstep(0.6, 0.85, frac(s.x * 3.7)) * 0.5 * (0.4 + p.z));\nc0 *= 0.92 + s.z * 0.16;\nfloat wt = smoothstep(1.0 - p.y * 0.7, 1.2 - p.y * 0.7, texToFloat(b.sample(uv)));\nc0 = lerp(c0, c0 * 0.55, wt * 0.8);\nc0 = lerp(c0, c0 * 0.8, s.w);\nreturn float4(c0, 1.0);",
       "z": 0.5,
       "y": 0.25
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.82 + a.sample(uv).z * 0.1;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.5 - a.sample(uv).y * 0.08 * (0.5 + p.x) + (a.sample(uv).z - 0.5) * 0.02 - a.sample(uv).w * 0.06;\nreturn float4(v, v, v, 1.0);",
       "x": 0.4
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "intensity": 1.0
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       960.0,
       160.0
      ],
      "values": {
       "radius": 0.02,
       "depth": 0.08,
       "strength": 0.8
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       960.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       1200.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       960.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       800.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1680.0,
       0.0
      ],
      "values": {}
     }
    ],
