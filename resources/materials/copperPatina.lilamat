      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Blotches",
      "type": "clouds",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 4,
       "octaves": 7,
       "persistence": 0.6,
       "mode": "billow"
      }
     },
     {
      "name": "Streaks",
      "type": "directional",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "angle": 90.0,
       "scaleAlong": 3,
       "scaleAcross": 18,
       "octaves": 5
      }
     },
     {
      "name": "Crust",
      "type": "worley",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 20,
       "octaves": 3,
       "persistence": 0.5
      }
     },
     {
      "name": "Grain",
      "type": "perlin",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 48,
       "octaves": 3
      }
     },
     {
      "name": "Patina",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float bl = texToFloat(a.sample(uv));\nfloat st = texToFloat(b.sample(uv));\nfloat cov = bl * 0.8 + st * 0.22 + (d.sample(uv) - 0.5) * 0.25;\nfloat pat = smoothstep(0.8 - p.x * 0.9, 0.8 - p.x * 0.9 + 0.2, cov);\nfloat rub = smoothstep(0.62, 0.7, d.sample(uv) * 0.5 + bl * 0.6) * p.y;\npat *= 1.0 - rub;\nfloat crust = smoothstep(0.1, 0.7, 1.0 - c.sample(uv)) * pat;\nreturn float4(pat, crust, rub, st);",
       "x": 0.6,
       "y": 0.25
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat g = texToFloat(b.sample(uv));\nfloat3 cu = lerp(lerp(float3(0.7529, 0.5412, 0.4392), float3(0.8471, 0.6588, 0.5569), g), float3(0.9412, 0.7686, 0.6824), s.z);\nfloat3 v = lerp(float3(0.3686, 0.5804, 0.5137), float3(0.6118, 0.7686, 0.6902), saturate(s.y * 1.3 + (g - 0.5) * 0.8 * (0.5 + p.z)));\nv = lerp(v, float3(0.2706, 0.4353, 0.3843), saturate((0.45 - s.w) * 1.2));\nv = lerp(v, float3(0.4784, 0.5412, 0.4157), (1.0 - s.x) * 0.5);\nreturn float4(lerp(cu, v, s.x), 1.0);",
       "z": 0.5
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = lerp(0.38, 0.88, a.sample(uv).x) - a.sample(uv).y * 0.05;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "MetalMask",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = 1.0 - smoothstep(0.42, 0.5, a.sample(uv).x);\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       480.0
      ],
      "values": {
       "expression": "float v = 0.5 + a.sample(uv).x * 0.06 + a.sample(uv).y * 0.05;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 0.6
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.02,
       "depth": 0.06,
       "strength": 0.8
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1200.0,
       0.0
      ],
      "values": {}
     }
    ],
    "links": [
     [
