   "CopperPatina": {
    "name": "CopperPatina",
    "typeVersion": 1,
    "description": "Weathered copper: brown tarnish under a crusty blue-green verdigris that gathers in low areas and streaks.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
