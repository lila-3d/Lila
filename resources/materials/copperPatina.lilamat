       "Patina.y"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.6,
      "label": "Age",
      "description": "Verdigris coverage.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Patina.x"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.z"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
