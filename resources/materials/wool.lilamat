  "subgroups": {
   "Wool": {
    "name": "Wool",
    "typeVersion": 1,
    "description": "Chunky stockinette knit: rows of V-shaped stitches in soft fuzzy wool.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Fuzz.seed",
       "Fibre.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.2,
      "label": "Wear",
      "description": "Pilling and felting.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Stitches.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.1,
      "label": "Age",
      "description": "Grime and fading.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Fuzz",
      "type": "perlin",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 96,
       "octaves": 3
      }
     },
     {
      "name": "Fibre",
      "type": "gabor",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 24,
       "impulses": 8,
       "frequency": 3.0,
       "angleRandom": 1.0
      }
     },
     {
      "name": "Stitches",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float2 N = float2(16.0, 20.0);\nfloat2 g = uv * N;\nfloat2 fr = frac(g);\nfloat2 q1 = fr - float2(0.27, 0.5);\nfloat2 q2 = fr - float2(0.73, 0.5);\nfloat a1 = 0.55;\nfloat2 r1 = float2(q1.x * cos(a1) - q1.y * sin(a1), q1.x * sin(a1) + q1.y * cos(a1));\nfloat2 r2 = float2(q2.x * cos(-a1) - q2.y * sin(-a1), q2.x * sin(-a1) + q2.y * cos(-a1));\nfloat e1 = length(r1 / float2(0.2, 0.52));\nfloat e2 = length(r2 / float2(0.2, 0.52));\nfloat l1 = sqrt(saturate(1.0 - e1 * e1));\nfloat l2 = sqrt(saturate(1.0 - e2 * e2));\nfloat2 g2 = g + float2(0.0, 0.5);\nfloat2 fr2 = frac(g2);\nfloat2 s1 = fr2 - float2(0.27, 0.5);\nfloat2 s2 = fr2 - float2(0.73, 0.5);\nfloat2 t1 = float2(s1.x * cos(a1) - s1.y * sin(a1), s1.x * sin(a1) + s1.y * cos(a1));\nfloat2 t2 = float2(s2.x * cos(-a1) - s2.y * sin(-a1), s2.x * sin(-a1) + s2.y * cos(-a1));\nfloat m1 = sqrt(saturate(1.0 - dot(t1 / float2(0.2, 0.52), t1 / float2(0.2, 0.52))));\nfloat m2 = sqrt(saturate(1.0 - dot(t2 / float2(0.2, 0.52), t2 / float2(0.2, 0.52))));\nfloat hgt = max(max(l1, l2), max(m1, m2) * 0.9);\nfloat fz = c.sample(uv);\nfloat fb = d.sample(uv);\nhgt = hgt * (0.85 + (fb - 0.5) * 0.3) + (fz - 0.5) * 0.08 * (1.0 + p.x);\nreturn float4(saturate(hgt), fz, fb, 1.0);",
       "x": 0.2
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat3 c0 = float3(0.7961, 0.7490, 0.6510) * (0.62 + s.x * 0.45) * (1.0 + (s.y - 0.5) * 0.15 * (0.5 + p.z));\nc0 *= 1.0 - p.y * 0.2;\nreturn float4(c0, 1.0);",
       "z": 0.5,
       "y": 0.1
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.95 + (a.sample(uv).y - 0.5) * 0.05;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.25 + a.sample(uv).x * 0.5;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 0.9
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.01,
       "depth": 0.2,
       "strength": 1.0
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1440.0,
       0.0
      ],
      "values": {}
     }
    ],
    "links": [
     [
      "Fuzz",
