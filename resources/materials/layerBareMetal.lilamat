   "LayerBareMetal": {
    "name": "LayerBareMetal",
    "typeVersion": 1,
    "description": "Freshly exposed steel as a layer, for edge wear: bright, finely scratched, slightly rougher where abraded.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Scratches.seed",
       "Mottle.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Wear",
      "description": "Scratch density.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.x",
       "Roughness.x",
       "Height.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.1,
      "label": "Age",
      "description": "Tarnish.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.z"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Scratches",
      "type": "scratches",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 8,
       "count": 6,
       "length": 0.5,
       "width": 0.0008,
       "angleRandom": 1.0
      }
     },
     {
      "name": "Mottle",
      "type": "clouds",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 4,
       "octaves": 5
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float3 c0 = float3(0.8118, 0.8196, 0.8235) * (0.95 + texToFloat(a.sample(uv)) * 0.08 * (0.5 + p.z));\nc0 = lerp(c0, float3(0.6588, 0.6431, 0.6196), p.y * 0.5);\nc0 *= 1.0 - c.sample(uv) * p.x * 0.1;\nreturn float4(c0, 1.0);",
       "x": 0.5,
       "y": 0.1,
       "z": 0.5
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       240.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.28 + c.sample(uv) * p.x * 0.25 + texToFloat(a.sample(uv)) * 0.1;\nreturn float4(v, v, v, 1.0);",
       "x": 0.5
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       240.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.5 - c.sample(uv) * p.x * 0.02;\nreturn float4(v, v, v, 1.0);",
       "x": 0.5
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "intensity": 0.3
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "radius": 0.005,
       "depth": 0.01,
       "strength": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       480.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "value": 1.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       960.0,
       0.0
      ],
      "values": {}
     }
    ],
