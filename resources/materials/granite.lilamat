  "subgroups": {
   "Granite": {
    "name": "Granite",
    "typeVersion": 1,
    "description": "Honed granite: interlocking feldspar, quartz and biotite grains in pink, grey and black, softly polished.",
    "inputs": [
     {
      "name": "seed",
