      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Feldspar.seed",
       "Quartz.seed",
       "GrainEdges.seed",
       "Broad.seed",
       "Grime.seed",
