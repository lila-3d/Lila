      "description": "Dulling and fine scratches.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Roughness.x",
       "Height.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.1,
      "label": "Age",
      "description": "Stains.",
      "min": 0.0,
      "max": 1.0,
