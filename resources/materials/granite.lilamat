    "nodes": [
     {
      "name": "Feldspar",
      "type": "cells",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 26,
       "mode": "cells",
       "jitter": 1.0
      }
     },
     {
      "name": "Quartz",
      "type": "cells",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 67,
       "mode": "cells",
       "jitter": 1.0
      }
     },
     {
      "name": "GrainEdges",
      "type": "cells",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 26,
       "mode": "f2MinusF1",
       "jitter": 1.0
      }
     },
     {
      "name": "Broad",
      "type": "clouds",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 3,
       "octaves": 5
      }
     },
     {
      "name": "Grains",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float f1 = texToFloat(a.sample(uv));\nfloat f2 = texToFloat(b.sample(uv));\nfloat e = c.sample(uv);\nfloat br = d.sample(uv);\nfloat mica = step(0.87 - (br - 0.5) * 0.15, f2);\nfloat spar = smoothstep(0.38, 0.46, f1 + (f2 - 0.5) * 0.15);\nreturn float4(spar, mica, f1, e);"
      }
     },
     {
      "name": "Grime",
      "type": "dirt",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "scale": 3,
       "amount": 0.5,
       "contrast": 1.0,
       "grain": 0.4
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 g = a.sample(uv);\nfloat3 quartz = lerp(float3(0.5608, 0.5529, 0.5412), float3(0.7098, 0.6980, 0.6784), frac(g.z * 7.0));\nfloat3 spar = lerp(float3(0.7216, 0.5569, 0.4863), float3(0.8275, 0.7686, 0.7216), frac(g.z * 3.0)) ;\nspar = lerp(float3(0.7882, 0.7647, 0.7333), spar, 0.5 + p.z * 0.5);\nfloat3 c0 = lerp(quartz, spar, g.x);\nc0 = lerp(c0, float3(0.1686, 0.1569, 0.1490), g.y);\nc0 *= 0.94 + smoothstep(0.0, 0.08, g.w) * 0.06;\nfloat st = smoothstep(1.0 - p.y * 0.5, 1.2 - p.y * 0.5, texToFloat(b.sample(uv)));\nc0 = lerp(c0, c0 * float3(0.7843, 0.7216, 0.6118), st);\nreturn float4(c0, 1.0);",
       "z": 0.5,
       "y": 0.1
      }
     },
     {
      "name": "Scratches",
      "type": "scratches",
      "position": [
       0.0,
       800.0
      ],
      "values": {
       "scale": 6,
       "count": 3,
       "length": 0.5,
       "width": 0.001,
       "angleRandom": 1.0
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.18 + a.sample(uv).y * 0.12 + frac(a.sample(uv).z * 5.0) * 0.06 + c.sample(uv) * p.x * 0.3 + p.x * 0.25;\nreturn float4(v, v, v, 1.0);",
       "x": 0.2
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.5 + smoothstep(0.0, 0.06, a.sample(uv).w) * 0.004 - c.sample(uv) * p.x * 0.01;\nreturn float4(v, v, v, 1.0);",
       "x": 0.2
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 0.5
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.01,
       "depth": 0.02,
       "strength": 0.3
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       960.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1440.0,
       0.0
      ],
      "values": {}
     }
