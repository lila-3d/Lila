  "subgroups": {
   "CarbonFibre": {
    "name": "CarbonFibre",
    "typeVersion": 1,
    "description": "2x2 twill carbon fibre under a glossy clear coat: tows catching the light in alternating directions.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Fibres.seed",
       "Scuffs.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.15,
      "label": "Wear",
      "description": "Scuffed clear coat.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Twill.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.05,
      "label": "Age",
      "description": "Dust and smears.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Roughness.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.z"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Fibres",
      "type": "anisotropic",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scaleX": 4,
       "scaleY": 256,
       "octaves": 3,
       "persistence": 0.6
      }
     },
     {
      "name": "Scuffs",
      "type": "scratches",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 6,
       "count": 4,
       "length": 0.4,
       "width": 0.0008,
       "angleRandom": 1.0
      }
     },
     {
      "name": "Twill",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float N = 16.0;\nfloat2 g = uv * N;\nint2 cell = int2(floor(g));\nfloat2 fr = frac(g);\nbool along = ((cell.x + cell.y + 4096) % 4) < 2;\nfloat dome = along ? sin(fr.y * 3.14159) : sin(fr.x * 3.14159);\nfloat fb = along ? texToFloat(a.sample(uv)) : texToFloat(a.sample(float2(uv.y, uv.x)));\nreturn float4(dome, along ? 1.0 : 0.0, fb, c.sample(uv) * p.x);",
       "x": 0.15
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 t = a.sample(uv);\nfloat3 c0 = lerp(float3(0.1373, 0.1412, 0.1529), float3(0.2275, 0.2353, 0.2549), t.y * (0.5 + t.x * 0.5));\nc0 *= 0.85 + t.z * 0.3 * (0.5 + p.z);\nc0 = lerp(c0, float3(0.4157, 0.4157, 0.4157), t.w * 0.4);\nreturn float4(c0, 1.0);",
       "z": 0.5
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.08 + a.sample(uv).w * 0.3 + p.y * 0.3;\nreturn float4(v, v, v, 1.0);",
       "y": 0.05
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.5 + a.sample(uv).x * 0.006;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 0.4
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.005,
       "depth": 0.02,
       "strength": 0.3
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1200.0,
       0.0
      ],
      "values": {}
     }
    ],
