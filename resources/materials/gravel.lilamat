      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "PebbleShape",
      "type": "perlin",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 3,
       "octaves": 3
      }
     },
     {
      "name": "Pebble",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float2 q = uv - 0.5;\nfloat n = texToFloat(a.sample(uv * 0.5 + 0.25));\nfloat r = length(q) * (1.0 + (n - 0.5) * 0.6);\nfloat v = sqrt(saturate(1.0 - (r / 0.42) * (r / 0.42)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Large",
      "type": "splatter",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "countX": 9,
       "countY": 9,
       "perCell": 3,
       "size": 0.75,
       "sizeRandom": 0.4,
       "valueRandom": 0.2,
       "blend": "max"
      }
     },
     {
      "name": "Small",
      "type": "splatter",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "countX": 18,
       "countY": 18,
       "perCell": 3,
       "size": 0.7,
       "sizeRandom": 0.5,
       "valueRandom": 0.3,
       "blend": "max"
      }
     },
     {
      "name": "Fines",
      "type": "perlin",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 96,
       "octaves": 2
      }
     },
     {
      "name": "Stones",
      "type": "pixelProcessor",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "expression": "float bg = c.sample(uv);\nfloat sm = d.sample(uv);\nfloat topBig = step(sm * 0.6, bg);\nfloat hgt = max(bg, sm * 0.6);\nfloat4 colr = lerp(b.sample(uv), a.sample(uv), topBig);\nreturn float4(hgt, colr.r, colr.g, step(0.02, hgt));"
      }
     },
     {
      "name": "Grime",
      "type": "dirt",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 4,
       "amount": 0.5,
       "contrast": 1.0,
       "grain": 0.4
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat k = s.y;\nfloat3 st = lerp(float3(0.4902, 0.4784, 0.4549), float3(0.6471, 0.6196, 0.5725), k);\nst = lerp(st, float3(0.7020, 0.6275, 0.5333), step(0.65, s.z) * (0.4 + p.z * 0.6));\nst = lerp(st, float3(0.3529, 0.3451, 0.3255), step(0.85, frac(s.z * 5.0)) * 0.7);\nst *= 0.8 + s.x * 0.25;\nfloat3 fn = float3(0.5412, 0.4902, 0.4157) * (0.85 + texToFloat(c.sample(uv)) * 0.3);\nfloat3 c0 = lerp(fn, st, s.w);\nc0 = lerp(c0, float3(0.5412, 0.4902, 0.4157), smoothstep(1.0 - p.y * 0.7, 1.2 - p.y * 0.7, texToFloat(b.sample(uv))) * 0.6);\nreturn float4(c0, 1.0);",
       "z": 0.5,
       "y": 0.2
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       960.0,
       160.0
      ],
      "values": {
       "expression": "float v = lerp(0.95, 0.72 - a.sample(uv).x * 0.15, a.sample(uv).w);\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       960.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.1 + a.sample(uv).x * (0.8 - p.x * 0.4) + (texToFloat(b.sample(uv)) - 0.5) * 0.02;\nreturn float4(v, v, v, 1.0);",
       "x": 0.2
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       1200.0,
       0.0
      ],
      "values": {
       "intensity": 1.5
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       1200.0,
       160.0
      ],
      "values": {
       "radius": 0.02,
       "depth": 0.2,
       "strength": 1.0
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       1200.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       1440.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       1200.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1920.0,
       0.0
      ],
      "values": {}
     }
    ],
