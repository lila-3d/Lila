  "subgroups": {
   "Gravel": {
    "name": "Gravel",
    "typeVersion": 1,
    "description": "Loose rounded gravel in mixed greys and buffs, piled over packed fines.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "PebbleShape.seed",
       "Large.seed",
       "Small.seed",
       "Fines.seed",
       "Grime.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.2,
      "label": "Wear",
      "description": "Stones pressed into the fines.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Height.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.2,
      "label": "Age",
      "description": "Dust and mud on the stones.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
