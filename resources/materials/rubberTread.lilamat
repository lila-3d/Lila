  "subgroups": {
   "RubberTread": {
    "name": "RubberTread",
    "typeVersion": 1,
    "description": "Tyre-style rubber tread: chevron blocks, deep grooves and fine sipes, worn smooth on the contact faces.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Grime.seed",
       "VariationNoise.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.3,
      "label": "Wear",
      "description": "Contact faces worn smooth.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Roughness.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.2,
      "label": "Age",
      "description": "Dust and mud in the grooves.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "Broad tonal variation across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Variation.z"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Grime",
      "type": "dirt",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 5,
       "amount": 0.5,
       "contrast": 1.0,
       "grain": 0.4
      }
     },
     {
      "name": "Tread",
      "type": "pixelProcessor",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "expression": "float2 g = float2(uv.x * 4.0, uv.y * 8.0);\nfloat2 fr = frac(g);\nfloat row = floor(g.y);\nfloat x = fr.x + abs(fr.y - 0.5) * 0.6 - (fmod(row, 2.0) * 0.5);\nfloat bx = frac(x);\nfloat block = smoothstep(0.08, 0.12, bx) * (1.0 - smoothstep(0.88, 0.92, bx)) * smoothstep(0.04, 0.08, fr.y) * (1.0 - smoothstep(0.92, 0.96, fr.y));\nfloat sipe = 1.0 - smoothstep(0.0, 0.012, abs(frac(bx * 3.0) - 0.5) * 0.33);\nfloat hgt = block * (1.0 - sipe * 0.6);\nreturn float4(hgt, block, sipe, 1.0);"
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float4 t = a.sample(uv);\nfloat3 c0 = float3(0.1686, 0.1686, 0.1686) * (0.85 + t.x * 0.2);\nfloat d = smoothstep(1.0 - p.y * 0.8, 1.2 - p.y * 0.8, texToFloat(b.sample(uv)) + (1.0 - t.y) * 0.4);\nc0 = lerp(c0, float3(0.4157, 0.3686, 0.3059), d * 0.7);\nreturn float4(c0, 1.0);",
       "y": 0.2
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       240.0,
       160.0
      ],
      "values": {
       "expression": "float v = lerp(0.92, 0.85 - p.x * 0.35, a.sample(uv).y);\nreturn float4(v, v, v, 1.0);",
       "x": 0.3
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       240.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.2 + a.sample(uv).x * 0.6;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "VariationNoise",
      "type": "clouds",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 3,
       "octaves": 5
      }
     },
     {
      "name": "Variation",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nreturn float4(c.rgb * (1.0 + (texToFloat(b.sample(uv)) - 0.5) * 0.25 * p.z), c.a);",
       "z": 0.5
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "intensity": 1.0
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "radius": 0.02,
       "depth": 0.2,
       "strength": 1.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       480.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1200.0,
       0.0
      ],
      "values": {}
     }
    ],
    "links": [
     [
      "Tread",
