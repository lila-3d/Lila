    "nodes": [
     {
      "name": "Fractures",
      "type": "cells",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 4,
       "mode": "crackle",
       "width": 0.008,
       "jitter": 1.0
      }
     },
     {
      "name": "Warp",
      "type": "perlin",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 6,
       "octaves": 4
      }
     },
     {
      "name": "FractureWarp",
      "type": "warp",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "mode": "gradient",
       "intensity": 0.8
      }
     },
     {
      "name": "Bubbles",
      "type": "worley",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 36,
       "octaves": 2,
       "invert": true
      }
     },
     {
      "name": "Depth",
      "type": "clouds",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 3,
       "octaves": 6
      }
     },
     {
      "name": "SkateMarks",
      "type": "scratches",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "scale": 4,
       "count": 4,
       "length": 0.9,
       "width": 0.0015,
       "angle": 10.0,
       "angleRandom": 0.4
      }
     },
     {
      "name": "Ice",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float ck = texToFloat(a.sample(uv)) * smoothstep(0.0, 0.6, p.y);\nfloat b0 = smoothstep(0.85, 0.95, texToFloat(b.sample(uv))) * p.y;\nfloat sc = d.sample(uv) * p.x;\nreturn float4(ck, b0, c.sample(uv), sc);",
       "x": 0.2,
       "y": 0.3
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat3 c0 = lerp(float3(0.3725, 0.5490, 0.6510), float3(0.6118, 0.7608, 0.8314), s.z * (0.6 + p.z * 0.4));\nc0 = lerp(c0, float3(0.8588, 0.9098, 0.9373), saturate(s.x + s.y * 0.7 + s.w * 0.5));\nreturn float4(c0, 1.0);",
       "z": 0.5
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.03 + a.sample(uv).w * 0.4 + a.sample(uv).x * 0.3;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.5 - a.sample(uv).x * 0.03 - a.sample(uv).w * 0.01;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "intensity": 0.6
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       960.0,
       160.0
      ],
      "values": {
       "radius": 0.01,
       "depth": 0.03,
       "strength": 0.3
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       960.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       1200.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       960.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       800.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
