  "subgroups": {
   "CeramicTiles": {
    "name": "CeramicTiles",
    "typeVersion": 1,
    "description": "Glazed square wall tiles: glossy glaze varying tile to tile, each set slightly off-true, cementitious grout.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Grid.seed",
       "Crazing.seed",
       "GlazeRipple.seed",
       "Grime.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.2,
      "label": "Wear",
      "description": "Chipped tile edges and crazing.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.x",
       "Height.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.25,
      "label": "Age",
      "description": "Dirty grout.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     },
     {
      "name": "glazeColor",
      "kind": "param",
      "type": "color",
      "default": [
       0.69387,
       0.66539,
       0.5972,
       1.0
      ],
      "label": "Glaze Colour",
      "description": "The glaze's colour (sRGB).",
      "targets": [
       "GlazeColor.color"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Grid",
      "type": "tiles",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "countX": 5,
       "countY": 5,
       "gap": 0.035,
       "bevel": 0.06
      }
     },
     {
      "name": "Crazing",
      "type": "cells",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 14,
       "mode": "crackle",
       "width": 0.004,
       "jitter": 1.0
      }
     },
     {
      "name": "GlazeRipple",
      "type": "perlin",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 16,
       "octaves": 3
      }
     },
     {
      "name": "Grime",
      "type": "dirt",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 6,
       "amount": 0.5,
       "contrast": 1.0,
       "grain": 0.4
      }
     },
     {
      "name": "Tiles",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float mask = texToFloat(a.sample(uv));\nfloat3 tu = b.sample(uv).xyz;\nfloat r = c.sample(uv);\nfloat tilt = dot(tu.xy - 0.5, float2(cos(r * 40.0), sin(r * 40.0))) * 0.03;\nreturn float4(mask, r, tilt, 1.0);"
      }
     },
     {
      "name": "GlazeColor",
      "type": "color",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "color": [
        0.69387,
        0.66539,
        0.5972,
        1.0
       ]
      }
     },
     {
      "name": "GlazeColorSrgb",
      "type": "pixelProcessor",
      "position": [
       240.0,
       160.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 l = saturate(c.rgb);\nreturn float4(lerp(1.055 * pow(l, 1.0 / 2.4) - 0.055, l * 12.92, step(l, 0.0031308)), c.a);"
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat3 gl = b.sample(uv).rgb * (1.0 + (s.y - 0.5) * 0.08 * (0.3 + p.z * 1.4));\nfloat g = d.sample(uv);\nfloat3 grout = lerp(float3(0.6392, 0.6157, 0.5725), float3(0.4314, 0.4039, 0.3608), smoothstep(0.3, 0.9, g) * p.y);\nfloat3 c0 = lerp(grout, gl, smoothstep(0.2, 0.5, s.x));\nc0 = lerp(c0, c0 * 0.85, c.sample(uv) * p.x);\nreturn float4(c0, 1.0);",
       "z": 0.5,
       "y": 0.25,
       "x": 0.2
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = lerp(0.9, 0.08 + (texToFloat(b.sample(uv)) - 0.5) * 0.04, smoothstep(0.3, 0.6, a.sample(uv).x));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.3 + a.sample(uv).x * 0.2 + a.sample(uv).z * a.sample(uv).x + (texToFloat(b.sample(uv)) - 0.5) * 0.004 * a.sample(uv).x - c.sample(uv) * p.x * 0.004;\nreturn float4(v, v, v, 1.0);",
       "x": 0.2
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 0.8
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.01,
       "depth": 0.05,
       "strength": 0.7
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       800.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1440.0,
       0.0
      ],
      "values": {}
     }
    ],
