  "subgroups": {
   "GlassFrosted": {
    "name": "GlassFrosted",
    "typeVersion": 1,
    "description": "Acid-etched frosted glass: soft milky diffusion with a fine satin texture. Translucent: uses the opacity channel.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Frost.seed",
       "Smudges.seed",
       "Scratches.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.1,
      "label": "Wear",
      "description": "Polished, clearer patches.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Dirt.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.1,
      "label": "Age",
      "description": "Smudges and grime.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Dirt.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     },
     {
      "name": "opacity",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Frost",
      "type": "perlin",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 96,
       "octaves": 3
      }
     },
     {
      "name": "Smudges",
      "type": "clouds",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 4,
       "octaves": 6
      }
     },
     {
      "name": "Scratches",
      "type": "scratches",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 5,
       "count": 3,
       "length": 0.5,
       "width": 0.0008,
       "angleRandom": 1.0
      }
     },
     {
      "name": "Dirt",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float sm = smoothstep(1.0 - p.y * 0.7, 1.3 - p.y * 0.7, texToFloat(a.sample(uv)));\nfloat sc = c.sample(uv) * smoothstep(0.0, 0.6, p.x);\nreturn float4(sm, sc, d.sample(uv), 1.0);",
       "x": 0.1,
       "y": 0.1
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat3 c0 = float3(0.8392, 0.8706, 0.8627) * (1.0 + (s.z - 0.5) * 0.02 * (0.5 + p.z));\nc0 = lerp(c0, float3(0.6039, 0.5843, 0.5412), s.x * 0.5);\nreturn float4(c0, 1.0);",
       "z": 0.5
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.4500 + (a.sample(uv).z - 0.5) * 0.2000 + a.sample(uv).x * 0.4 + a.sample(uv).y * 0.3;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Opacity",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = saturate(0.5500 + a.sample(uv).x * 0.4 + a.sample(uv).y * 0.3);\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       480.0
      ],
      "values": {
       "expression": "float v = 0.5 + (a.sample(uv).z - 0.5) * 0.0100 - a.sample(uv).y * 0.002;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 0.5
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.005,
       "depth": 0.01,
       "strength": 0.0
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1440.0,
       0.0
      ],
      "values": {}
     }
    ],
