    ],
    "values": {
     "group": "LayerPaintChip",
     "seed": 0,
     "wear": 0.2,
     "age": 0.2,
     "colorVariation": 0.5,
     "hue": 0.0,
     "paintColor": [
      0.43415,
      0.06301,
      0.02843,
      1.0
     ]
    }
   },
   {
