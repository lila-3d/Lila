  "subgroups": {
   "LayerPaintChip": {
    "name": "LayerPaintChip",
    "typeVersion": 1,
    "description": "A paint coat as a layer, for masking with chips: satin enamel with thickness, so chipped edges step down to what is under.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Peel.seed",
       "Scuffs.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.2,
      "label": "Wear",
      "description": "Scuffs on the paint.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.x",
       "Roughness.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.2,
      "label": "Age",
      "description": "Fading and chalking.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.y",
       "Roughness.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     },
     {
      "name": "paintColor",
      "kind": "param",
      "type": "color",
      "default": [
       0.43415,
       0.06301,
       0.02843,
       1.0
      ],
      "label": "Paint Colour",
      "description": "The paint's colour (sRGB).",
      "targets": [
       "PaintColor.color"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "PaintColor",
      "type": "color",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "color": [
        0.43415,
        0.06301,
        0.02843,
        1.0
       ]
      }
     },
     {
      "name": "PaintColorSrgb",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 l = saturate(c.rgb);\nreturn float4(lerp(1.055 * pow(l, 1.0 / 2.4) - 0.055, l * 12.92, step(l, 0.0031308)), c.a);"
      }
     },
     {
      "name": "Peel",
      "type": "perlin",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 64,
       "octaves": 2
      }
     },
     {
      "name": "Scuffs",
      "type": "scratches",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 6,
       "count": 4,
       "length": 0.4,
       "width": 0.001,
       "angleRandom": 1.0
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float3 c0 = a.sample(uv).rgb * (1.0 + (d.sample(uv) - 0.5) * 0.05 * (0.5 + p.z));\nc0 = lerp(c0, dot(c0, float3(0.3, 0.4, 0.3)).xxx * 1.15 + 0.05, p.y * 0.4);\nc0 = lerp(c0, c0 * 1.15, c.sample(uv) * p.x);\nreturn float4(saturate(c0), 1.0);",
       "x": 0.2,
       "y": 0.2,
       "z": 0.5
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       240.0,
       160.0
      ],
      "values": {
       "expression": "float v = 0.38 + p.y * 0.3 + c.sample(uv) * p.x * 0.3;\nreturn float4(v, v, v, 1.0);",
       "x": 0.2,
       "y": 0.2
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       240.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.56 + (d.sample(uv) - 0.5) * 0.004;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "intensity": 0.4
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "radius": 0.005,
       "depth": 0.01,
       "strength": 0.0
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       480.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1440.0,
       0.0
      ],
      "values": {}
     }
    ],
    "links": [
     [
      "PaintColor",
      "out",
