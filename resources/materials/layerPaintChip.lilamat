    ]
   },
   {
    "name": "wear",
    "kind": "param",
    "type": "float",
    "default": 0.2,
    "label": "Wear",
    "description": "Scuffs on the paint.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
     "Material.wear"
    ]
   },
   {
    "name": "age",
    "kind": "param",
    "type": "float",
    "default": 0.2,
    "label": "Age",
    "description": "Fading and chalking.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
     "Material.age"
    ]
   },
   {
    "name": "colorVariation",
    "kind": "param",
    "type": "float",
    "default": 0.5,
    "label": "Colour Variation",
    "description": "How much the colour wanders across the surface.",
    "min": 0.0,
    "max": 1.0,
    "targets": [
     "Material.colorVariation"
    ]
   },
   {
    "name": "hue",
    "kind": "param",
    "type": "float",
    "default": 0.0,
    "label": "Hue",
    "description": "Shifts the base colour's hue, in turns.",
    "min": -0.5,
    "max": 0.5,
    "targets": [
     "Material.hue"
    ]
   },
   {
    "name": "paintColor",
    "kind": "param",
    "type": "color",
    "default": [
     0.43415,
     0.06301,
     0.02843,
     1.0
    ],
    "label": "Paint Colour",
    "description": "The paint's colour (sRGB).",
    "targets": [
     "Material.paintColor"
    ]
   }
  ],
  "nodes": [
