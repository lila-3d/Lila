{
 "format": "lilamat",
 "version": 1,
 "name": "LayerPaintChip",
 "meta": {
  "name": "Paint Chips",
  "category": "Layer/Paint",
  "tags": [
   "layer",
   "paint",
   "chips",
   "enamel",
   "smart"
  ],
  "physical": "dielectric",
  "scaleCm": 60,
  "tileable": true,
  "seedParam": "seed",
  "variationParams": [
   "wear",
   "age",
   "colorVariation",
   "hue",
   "paintColor"
  ],
  "author": "Lila",
  "licence": "CC0-1.0",
  "version": "1.0",
  "description": "A paint coat as a layer, for masking with chips: satin enamel with thickness, so chipped edges step down to what is under.",
  "layer": {
   "generator": "genPaintChips",
   "channels": [
    "baseColor",
    "roughness",
    "metallic",
    "height"
   ],
   "blend": {}
  }
 },
 "graph": {
  "name": "LayerPaintChip",
  "typeVersion": 1,
  "description": "A paint coat as a layer, for masking with chips: satin enamel with thickness, so chipped edges step down to what is under.",
  "inputs": [
   {
    "name": "seed",
