  "subgroups": {
   "Soil": {
    "name": "Soil",
    "typeVersion": 1,
    "description": "Dark crumbly soil: clods, grit and small stones, damp patches and bits of root.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Clods.seed",
       "Lumps.seed",
       "PebbleShape.seed",
       "Stones.seed",
       "Grit.seed",
       "Damp.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.2,
      "label": "Wear",
      "description": "Trampled, flattened areas.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Surface.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.3,
      "label": "Age",
      "description": "Dampness.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.y",
       "Roughness.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "BaseColor.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "Clods",
      "type": "worley",
      "position": [
       0.0,
       0.0
      ],
      "values": {
       "scale": 14,
       "octaves": 3,
       "persistence": 0.55,
       "invert": true
      }
     },
     {
      "name": "Lumps",
      "type": "clouds",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "scale": 4,
       "octaves": 6
      }
     },
     {
      "name": "PebbleShape",
      "type": "perlin",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 3,
       "octaves": 3
      }
     },
     {
      "name": "Pebble",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float2 q = uv - 0.5;\nfloat n = texToFloat(a.sample(uv * 0.5 + 0.25));\nfloat r = length(q) * (1.0 + (n - 0.5) * 0.6);\nfloat v = sqrt(saturate(1.0 - (r / 0.42) * (r / 0.42)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Stones",
      "type": "splatter",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "countX": 10,
       "countY": 10,
       "perCell": 1,
       "size": 0.3,
       "sizeRandom": 0.6,
       "valueRandom": 0.3,
       "blend": "max"
      }
     },
     {
      "name": "Grit",
      "type": "perlin",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scale": 128,
       "octaves": 2
      }
     },
     {
      "name": "Surface",
      "type": "pixelProcessor",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "expression": "float cl = texToFloat(a.sample(uv));\nfloat lp = texToFloat(b.sample(uv));\nfloat st = c.sample(uv);\nfloat flat = smoothstep(0.7 - p.x * 0.5, 0.9 - p.x * 0.5, lp);\nfloat hgt = lerp(cl * 0.5 + lp * 0.5, lp * 0.6 + 0.2, flat);\nreturn float4(hgt, st, d.sample(uv), flat);",
       "x": 0.2
      }
     },
     {
      "name": "Damp",
      "type": "clouds",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "scale": 3,
       "octaves": 5
      }
     },
     {
      "name": "BaseColor",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat3 c0 = lerp(float3(0.2431, 0.1843, 0.1333), float3(0.4196, 0.3294, 0.2510), saturate(s.x * 0.9 + (s.z - 0.5) * 0.3 * (0.5 + p.z)));\nc0 = lerp(c0, lerp(float3(0.3059, 0.2745, 0.2353), float3(0.4510, 0.4078, 0.3529), s.z) * (0.7 + s.y * 0.4), smoothstep(0.2, 0.4, s.y));\nfloat dmp = smoothstep(1.0 - p.y, 1.2 - p.y, texToFloat(b.sample(uv)) + (1.0 - s.x) * 0.3);\nc0 *= lerp(1.0, 0.62, dmp);\nreturn float4(c0, 1.0);",
       "z": 0.5,
       "y": 0.3
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       960.0,
       160.0
      ],
      "values": {
       "expression": "float4 s = a.sample(uv);\nfloat dmp = smoothstep(1.0 - p.y, 1.2 - p.y, texToFloat(b.sample(uv)) + (1.0 - s.x) * 0.3);\nfloat r = lerp(0.95, 0.55, dmp) - smoothstep(0.2, 0.4, s.y) * 0.15;\nreturn float4(r, r, r, 1.0);",
       "y": 0.3
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       960.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.2 + a.sample(uv).x * 0.4 + a.sample(uv).y * 0.25 + (a.sample(uv).z - 0.5) * 0.02;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       1200.0,
       0.0
      ],
      "values": {
       "intensity": 1.2
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       1200.0,
       160.0
      ],
      "values": {
       "radius": 0.02,
       "depth": 0.15,
       "strength": 1.0
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       1200.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       1440.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       1200.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       800.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1920.0,
       0.0
      ],
      "values": {}
     }
    ],
