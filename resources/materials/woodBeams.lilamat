  "subgroups": {
   "WoodBeams": {
    "name": "WoodBeams",
    "typeVersion": 1,
    "description": "Rough-sawn structural timber: open grain, drying checks along the length and dark aged tones.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "GrainWarp.seed",
       "GrainFibre.seed",
       "Checks.seed",
       "SawMarks.seed",
       "Grime.seed"
      ]
     },
     {
      "name": "wear",
      "kind": "param",
      "type": "float",
      "default": 0.4,
      "label": "Wear",
      "description": "Checks and splits along the grain.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Checks2.x"
      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.4,
      "label": "Age",
      "description": "Darkening and grime.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Checks2.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
      "type": "float",
      "default": 0.5,
      "label": "Colour Variation",
      "description": "How much the colour wanders across the surface.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "WoodColor.z"
      ]
     },
     {
      "name": "hue",
      "kind": "param",
      "type": "float",
      "default": 0.0,
      "label": "Hue",
      "description": "Shifts the base colour's hue, in turns.",
      "min": -0.5,
      "max": 0.5,
      "targets": [
       "Tint.hue"
      ]
     }
    ],
    "outputs": [
     {
      "name": "baseColor",
      "type": "color"
     },
     {
      "name": "roughness",
      "type": "gray"
     },
     {
      "name": "metallic",
      "type": "gray"
     },
     {
      "name": "height",
      "type": "gray"
     },
     {
      "name": "normal",
      "type": "color"
     },
     {
      "name": "ao",
      "type": "gray"
     }
    ],
    "nodes": [
     {
      "name": "BeamUv",
      "type": "uv",
      "position": [
       0.0,
       0.0
      ],
      "values": {}
     },
     {
      "name": "BeamRandom",
      "type": "constant",
      "position": [
       0.0,
       160.0
      ],
      "values": {
       "value": 0.37
      }
     },
     {
      "name": "GrainWarp",
      "type": "perlin",
      "position": [
       0.0,
       320.0
      ],
      "values": {
       "scale": 5,
       "octaves": 5,
       "persistence": 0.5
      }
     },
     {
      "name": "GrainFibre",
      "type": "anisotropic",
      "position": [
       0.0,
       480.0
      ],
      "values": {
       "scaleX": 4,
       "scaleY": 200,
       "octaves": 4,
       "persistence": 0.65
      }
     },
     {
      "name": "Grain",
      "type": "pixelProcessor",
      "position": [
       240.0,
       0.0
      ],
      "values": {
       "expression": "float2 q = a.sample(uv).xy;\nfloat r = texToFloat(b.sample(uv));\nfloat w = c.sample(uv);\nfloat fb = d.sample(uv);\nfloat Y = q.y * 60.0000;\nfloat X = q.x * 60.0000;\nfloat y0 = frac(r * 7.13) * 60.0000 * 1.4 - 60.0000 * 0.2;\nfloat dep = 2.0 + frac(r * 3.71) * 14.0;\nfloat taper = (0.04 + frac(r * 5.3) * 0.08) * (frac(r * 9.1) > 0.5 ? 1.0 : -1.0);\nfloat rad = sqrt((Y - y0) * (Y - y0) + dep * dep) + X * taper + (w - 0.5) * 1.6 + sin(X * 0.08 + r * 20.0) * 0.4;\nfloat spacing = 1.1000 * (0.75 + frac(r * 2.9) * 0.5) * (1.0 + (w - 0.5) * 0.3);\nfloat t = frac(rad / spacing);\nfloat late = smoothstep(0.45, 0.8, t) * (1.0 - smoothstep(0.88, 1.0, t));\nreturn float4(t, late, fb, r);"
      }
     },
     {
      "name": "Checks",
      "type": "directional",
      "position": [
       0.0,
       640.0
      ],
      "values": {
       "angle": 0.0,
       "scaleAlong": 2,
       "scaleAcross": 40,
       "octaves": 3,
       "persistence": 0.4
      }
     },
     {
      "name": "SawMarks",
      "type": "anisotropic",
      "position": [
       0.0,
       800.0
      ],
      "values": {
       "scaleX": 60,
       "scaleY": 3,
       "octaves": 2
      }
     },
     {
      "name": "Grime",
      "type": "dirt",
      "position": [
       0.0,
       960.0
      ],
      "values": {
       "scale": 4,
       "amount": 0.5,
       "contrast": 1.0,
       "grain": 0.4
      }
     },
     {
      "name": "Checks2",
      "type": "pixelProcessor",
      "position": [
       240.0,
       160.0
      ],
      "values": {
       "expression": "float k = texToFloat(a.sample(uv));\nfloat crack = smoothstep(0.8 - p.x * 0.15, 0.86 - p.x * 0.15, k);\nfloat saw = c.sample(uv);\nfloat g = texToFloat(b.sample(uv));\nfloat grime = smoothstep(1.0 - p.y * 0.7, 1.25 - p.y * 0.7, g);\nreturn float4(crack, saw, grime, 1.0);",
       "x": 0.4,
       "y": 0.4
      }
     },
     {
      "name": "WoodColor",
      "type": "pixelProcessor",
      "position": [
       480.0,
       0.0
      ],
      "values": {
       "expression": "float4 g = a.sample(uv);\nfloat tone = (g.w - 0.5) * 0.35 * (0.3 + p.z);\nfloat3 e = float3(0.5412, 0.3922, 0.2510) * (1.0 + tone) * (1.0 + (g.z - 0.5) * 0.18);\nfloat3 l = float3(0.3529, 0.2353, 0.1333) * (1.0 + tone * 0.8);\nfloat3 c0 = lerp(e, l, g.y);\n\nfloat4 w = b.sample(uv);\nc0 *= 0.92 + w.y * 0.16;\nc0 = lerp(c0, c0 * 0.4, w.x);\nc0 = lerp(c0, c0 * 0.6, w.z * 0.6);\nreturn float4(saturate(c0), 1.0);",
       "z": 0.5
      }
     },
     {
      "name": "Roughness",
      "type": "pixelProcessor",
      "position": [
       480.0,
       160.0
      ],
      "values": {
       "expression": "float v = lerp(0.7, 0.88, a.sample(uv).z) + b.sample(uv).x * 0.08;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Height",
      "type": "pixelProcessor",
      "position": [
       480.0,
       320.0
      ],
      "values": {
       "expression": "float v = 0.5 + a.sample(uv).y * 0.02 + (b.sample(uv).y - 0.5) * 0.03 - b.sample(uv).x * 0.2 + (a.sample(uv).z - 0.5) * 0.02;\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Normal",
      "type": "heightToNormal",
      "position": [
       720.0,
       0.0
      ],
      "values": {
       "intensity": 1.0
      }
     },
     {
      "name": "Occlusion",
      "type": "ambientOcclusion",
      "position": [
       720.0,
       160.0
      ],
      "values": {
       "radius": 0.02,
       "depth": 0.1,
       "strength": 1.0
      }
     },
     {
      "name": "Tint",
      "type": "hsv",
      "position": [
       720.0,
       320.0
      ],
      "values": {
       "hue": 0.0
      }
     },
     {
      "name": "BaseColorLinear",
      "type": "pixelProcessor",
      "position": [
       960.0,
       0.0
      ],
      "values": {
       "expression": "float4 c = a.sample(uv);\nfloat3 s = saturate(c.rgb);\nreturn float4(lerp(pow((s + 0.055) / 1.055, 2.4), s / 12.92, step(s, 0.04045)), c.a);"
      }
     },
     {
      "name": "RoughnessClamp",
      "type": "pixelProcessor",
      "position": [
       720.0,
       480.0
      ],
      "values": {
       "expression": "float v = saturate(texToFloat(a.sample(uv)));\nreturn float4(v, v, v, 1.0);"
      }
     },
     {
      "name": "Metallic",
      "type": "constant",
      "position": [
       0.0,
       1120.0
      ],
      "values": {
       "value": 0.0
      }
     },
     {
      "name": "GroupOutput",
      "type": "GroupOutput",
      "position": [
       1440.0,
       0.0
      ],
      "values": {}
     }
    ],
