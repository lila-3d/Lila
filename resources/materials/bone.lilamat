      ]
     },
     {
      "name": "age",
      "kind": "param",
      "type": "float",
      "default": 0.3,
      "label": "Age",
      "description": "Cracks and staining.",
      "min": 0.0,
      "max": 1.0,
      "targets": [
       "Bone.y",
       "BaseColor.y"
      ]
     },
     {
      "name": "colorVariation",
      "kind": "param",
