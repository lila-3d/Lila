  "subgroups": {
   "Bone": {
    "name": "Bone",
    "typeVersion": 1,
    "description": "Weathered bone: ivory surface over porous, open bone where it is worn, fine cracks and brown staining.",
    "inputs": [
     {
      "name": "seed",
      "kind": "param",
      "type": "seed",
      "default": 0,
      "label": "Seed",
      "description": "Changes the pattern without changing the look.",
      "targets": [
       "Porous.seed",
       "Fibre.seed",
