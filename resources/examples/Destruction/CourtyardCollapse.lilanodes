  "format": "lila.nodes",
  "group": {
    "description": "Four concrete walls blown apart by seven explosions, then the slab they stand on rumbles and gives way from one side to the other.",
    "inputs": [
      {
        "default": 220,
        "description": "Roughly how many pieces the slab breaks into.",
        "label": "Ground Pieces",
        "min": 1.0,
        "name": "groundPieces",
        "panel": "Pieces",
        "softMax": 600.0,
        "type": "int"
      },
      {
        "default": 70,
        "description": "Roughly how many pieces each wall breaks into.",
        "label": "Wall Pieces",
        "min": 1.0,
        "name": "wallPieces",
        "panel": "Pieces",
        "softMax": 300.0,
        "type": "int"
      },
      {
        "default": 1,
        "description": "Another seed gives another crack pattern.",
        "label": "Seed",
        "name": "seed",
        "panel": "Pieces",
        "type": "int"
      },
      {
        "default": 20.0,
        "description": "How hard the concrete is to break, N per cm2 two pieces share.",
        "label": "Strength",
        "min": 0.0,
        "name": "strength",
        "panel": "Pieces",
        "softMax": 200.0,
        "type": "float"
      },
      {
        "default": 1.0,
        "description": "Scales every explosion's speed.",
        "label": "Blast",
        "min": 0.0,
        "name": "blast",
        "panel": "Explosions",
        "softMax": 3.0,
        "type": "float"
      },
      {
        "default": 125.0,
        "description": "Frame the first ground pieces fall.",
