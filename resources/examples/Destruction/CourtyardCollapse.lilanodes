        "name": "collapseStart",
        "panel": "Collapse",
        "type": "float"
      },
      {
        "default": 75.0,
        "description": "Frames for the failure to cross the slab.",
        "label": "Collapse Duration",
        "min": 1.0,
        "name": "collapseDuration",
        "panel": "Collapse",
        "type": "float"
      },
      {
        "default": 4.0,
        "description": "How far the ground shakes before it falls, cm.",
        "label": "Rumble",
        "min": 0.0,
        "name": "rumble",
        "panel": "Collapse",
        "softMax": 20.0,
        "type": "float"
      }
