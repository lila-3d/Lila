{
  "dependencies": [],
  "format": "lila.nodes",
  "group": {
    "description": "Jagged spikes bursting out of a dome, for Niagara mesh flipbooks. Key Growth and Evolution.",
    "inputs": [
      {
        "default": 1.0,
        "description": "How far the spikes are out. Key 0 to 1 for the burst.",
        "label": "Growth",
        "max": 2.0,
        "min": 0.0,
        "name": "growth",
        "panel": "Animation",
        "softMax": 1.0,
        "subtype": "factor",
        "type": "float"
      },
      {
        "default": 0.0,
        "description": "Moves through the cell pattern so the spikes change shape over time. Key it.",
        "label": "Evolution",
        "name": "evolution",
        "panel": "Animation",
        "type": "float"
      },
      {
        "default": 120.0,
        "description": "How far the longest spikes reach.",
        "label": "Spike Length",
        "min": 0.0,
        "name": "spikeLength",
        "panel": "Spikes",
        "softMax": 300.0,
        "subtype": "distance",
        "type": "float"
      },
      {
        "default": 0.04,
        "description": "Cells per cm: higher gives more, thinner spikes.",
        "label": "Density",
        "min": 0.001,
        "name": "density",
        "panel": "Spikes",
        "softMax": 0.1,
        "step": 0.005,
        "type": "float"
      },
      {
        "default": 3.0,
        "description": "Higher keeps only the tallest peaks, for fewer, thinner needles.",
        "label": "Sharpness",
        "min": 0.25,
        "name": "sharpness",
        "panel": "Spikes",
        "softMax": 6.0,
        "type": "float"
      },
      {
        "default": 0.7,
        "description": "How irregular the cell layout is.",
        "label": "Randomness",
        "max": 1.0,
        "min": 0.0,
        "name": "randomness",
        "panel": "Spikes",
        "subtype": "factor",
        "type": "float"
      },
      {
        "default": 0.15,
        "description": "Spike length at the base relative to the tip.",
        "label": "Base Spikes",
        "max": 1.0,
        "min": 0.0,
        "name": "baseFalloff",
        "panel": "Spikes",
        "subtype": "factor",
        "type": "float"
      },
      {
        "default": 160.0,
        "description": "Distance from the origin where the red vertex colour reaches 1 (Niagara reads it as the fade mask).",
        "label": "Gradient Length",
        "min": 1.0,
        "name": "gradientEnd",
        "panel": "Colour",
        "softMax": 500.0,
        "subtype": "distance",
        "type": "float"
      }
    ],
