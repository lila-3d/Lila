{
  "format": "lilatexnode",
  "version": 1,
  "type": "curvatureSplit",
  "label": "Curvature Split",
  "category": "Mask",
  "doc": "Splits a curvature map (0.5 flat) into convex (edges) and concave (crevices) masks, scaled by strength.",
  "inputs": [
    {
      "id": "curvature",
      "type": "gray",
      "default": 0.5
    }
  ],
  "outputs": [
    {
      "id": "convex",
      "type": "gray"
    },
    {
      "id": "concave",
      "type": "gray"
    }
  ],
  "params": [
    {
      "id": "strength",
      "type": "float",
      "default": 1.0,
      "min": 0,
      "softMax": 8
    }
  ],
  "cost": 2,
  "body": {
    "convex": "return saturate((curvature.sample(uv) - 0.5) * 2.0 * p.strength);",
    "concave": "return saturate((0.5 - curvature.sample(uv)) * 2.0 * p.strength);"
  }
}
