  "type": "meshAo",
  "label": "Ambient Occlusion",
  "category": "Mesh",
  "doc": "Ambient occlusion from the set's bake: 1 open, darker where occluded. Reads (u, v, 0) when the map isn't supplied.",
  "inputs": [],
