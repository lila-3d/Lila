{
  "format": "lilatexnode",
  "version": 1,
  "type": "genAoDarken",
  "label": "AO Darken",
  "category": "Generator",
  "doc": "A mask of the occluded areas from ambient occlusion, for darkening or tinting them.",
  "kind": "graph",
  "graph": {
    "name": "genAoDarken",
    "typeVersion": 1,
    "description": "A mask of the occluded areas from ambient occlusion, for darkening or tinting them.",
    "inputs": [
      {
        "name": "ao",
        "kind": "port",
        "type": "gray",
        "default": 1.0,
        "description": "Ambient occlusion mesh map."
      },
      {
        "name": "level",
        "kind": "param",
        "type": "float",
        "default": 0.4,
        "targets": [
          "Remap.level"
        ],
        "min": 0,
        "max": 1
      },
      {
        "name": "softness",
        "kind": "param",
        "type": "float",
        "default": 0.8,
        "targets": [
          "Remap.softness"
        ],
        "min": 0,
        "max": 1
      }
    ],
    "outputs": [
      {
        "name": "mask",
        "type": "gray"
      }
    ],
    "nodes": [
      {
        "name": "GroupInput",
        "type": "GroupInput",
        "position": [
          -400,
          0
        ]
      },
      {
        "name": "GroupOutput",
        "type": "GroupOutput",
        "position": [
          0,
          0
        ]
      },
      {
        "name": "Remap",
        "type": "maskRemap",
        "position": [
          -200,
          0
        ],
        "values": {
          "level": 0.4,
          "softness": 0.8,
          "invert": true
        }
      }
    ],
    "links": [
      [
        "GroupInput",
        "ao",
        "Remap",
        "value"
      ],
      [
        "Remap",
        "out",
        "GroupOutput",
        "mask"
      ]
    ]
  }
}
