<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Copper: OpenPBR with a roughness texture through a nodegraph, read from UV set 1 with clamped, closest sampling. -->
  <nodegraph name="NG_Copper" fileprefix="./tex/">
    <texcoord name="uv1" type="vector2">
      <input name="index" type="integer" value="1" />
    </texcoord>
    <image name="rough_tex" type="float">
      <input name="file" type="filename" value="leaf_orm.png" />
      <input name="texcoord" type="vector2" nodename="uv1" />
      <input name="uaddressmode" type="string" value="clamp" />
      <input name="filtertype" type="string" value="closest" />
    </image>
    <output name="out_rough" type="float" nodename="rough_tex" />
  </nodegraph>
  <open_pbr_surface name="SR_Copper" type="surfaceshader">
    <input name="base_color" type="color3" value="0.95, 0.64, 0.54" />
    <input name="base_metalness" type="float" value="1" />
    <input name="specular_roughness" type="float" nodegraph="NG_Copper" output="out_rough" />
  </open_pbr_surface>
  <surfacematerial name="Copper" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_Copper" />
  </surfacematerial>

  <!-- Velvet: Standard Surface with sheen, which Lila has no equivalent for. -->
  <standard_surface name="SR_Velvet" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="base_color" type="color3" value="0.4, 0.05, 0.1" />
    <input name="specular_roughness" type="float" value="0.6" />
    <input name="sheen" type="float" value="0.8" />
  </standard_surface>
  <surfacematerial name="Velvet" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_Velvet" />
  </surfacematerial>
</materialx>
