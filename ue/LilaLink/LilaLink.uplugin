{
	"FileVersion": 3,
	"Version": 3,
	"VersionName": "0.3.0",
	"FriendlyName": "Lila Link",
	"Description": "Lets the Lila DCC import and reimport assets into this project over a localhost JSON-RPC socket.",
	"Category": "Editor",
	"CreatedBy": "Lila",
	"CanContainContent": false,
	"EnabledByDefault": true,
	"Modules": [
		{
			"Name": "LilaLink",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit",
			"PlatformAllowList": [ "Win64", "Mac", "Linux" ]
		}
	],
	"Plugins": [
		{
			"Name": "Interchange",
			"Enabled": true
		},
		{
			"Name": "PythonScriptPlugin",
			"Enabled": true,
			"Optional": true
		}
	]
}
